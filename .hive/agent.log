{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FGJvNfcYvHRKnmYaftr7FY","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\trequire 'English'\n4\t\n5\tmodule Liquid\n6\t  class BlockBody\n7\t    LiquidTagToken      = /\\A\\s*(#{TagName})\\s*(.*?)\\z/o\n8\t    FullToken           = /\\A#{TagStart}#{WhitespaceControl}?(\\s*)(#{TagName})(\\s*)(.*?)#{WhitespaceControl}?#{TagEnd}\\z/om\n9\t    FullTokenPossiblyInvalid = /\\A(.*)#{TagStart}#{WhitespaceControl}?\\s*(\\w+)\\s*(.*)?#{WhitespaceControl}?#{TagEnd}\\z/om\n10\t    ContentOfVariable   = /\\A#{VariableStart}#{WhitespaceControl}?(.*?)#{WhitespaceControl}?#{VariableEnd}\\z/om\n11\t    WhitespaceOrNothing = /\\A\\s*\\z/\n12\t    TAGSTART            = \"{%\"\n13\t    VARSTART            = \"{{\"\n14\t\n15\t    attr_reader :nodelist\n16\t\n17\t    def initialize\n18\t      @nodelist = []\n19\t      @blank    = true\n20\t    end\n21\t\n22\t    def parse(tokenizer, parse_context, &block)\n23\t      raise FrozenError, \"can't modify frozen Liquid::BlockBody\" if frozen?\n24\t\n25\t      parse_context.line_number = tokenizer.line_number\n26\t\n27\t      if tokenizer.for_liquid_tag\n28\t        parse_for_liquid_tag(tokenizer, parse_context, &block)\n29\t      else\n30\t        parse_for_document(tokenizer, parse_context, &block)\n31\t      end\n32\t    end\n33\t\n34\t    def freeze\n35\t      @nodelist.freeze\n36\t      super\n37\t    end\n38\t\n39\t    private def parse_for_liquid_tag(tokenizer, parse_context)\n40\t      while (token = tokenizer.shift)\n41\t        unless token.empty? || BlockBody.blank_string?(token)\n42\t          unless token =~ LiquidTagToken\n43\t            # line isn't empty but didn't match tag syntax, yield and let the\n44\t            # caller raise a syntax error\n45\t            return yield token, token\n46\t          end\n47\t          tag_name = Regexp.last_match(1)\n48\t          markup   = Regexp.last_match(2)\n49\t\n50\t          if tag_name == 'liquid'\n51\t            parse_context.line_number -= 1\n52\t            next parse_liquid_tag(markup, parse_context)\n53\t          end\n54\t\n55\t          unless (tag = parse_context.environment.tag_for_name(tag_name))\n56\t            # end parsing if we reach an unknown tag and let the caller decide\n57\t            # determine how to proceed\n58\t            return yield tag_name, markup\n59\t          end\n60\t          new_tag = tag.parse(tag_name, markup, tokenizer, parse_context)\n61\t          @blank &&= new_tag.blank?\n62\t          @nodelist << new_tag\n63\t        end\n64\t        parse_context.line_number = tokenizer.line_number\n65\t      end\n66\t\n67\t      yield nil, nil\n68\t    end\n69\t\n70\t    # @api private\n71\t    def self.unknown_tag_in_liquid_tag(tag, parse_context)\n72\t      Block.raise_unknown_tag(tag, 'liquid', '%}', parse_context)\n73\t    end\n74\t\n75\t    # @api private\n76\t    def self.raise_missing_tag_terminator(token, parse_context)\n77\t      raise SyntaxError, parse_context.locale.t(\"errors.syntax.tag_termination\", token: token, tag_end: TagEnd.inspect)\n78\t    end\n79\t\n80\t    # @api private\n81\t    def self.raise_missing_variable_terminator(token, parse_context)\n82\t      raise SyntaxError, parse_context.locale.t(\"errors.syntax.variable_termination\", token: token, tag_end: VariableEnd.inspect)\n83\t    end\n84\t\n85\t    # @api private\n86\t    def self.render_node(context, output, node)\n87\t      node.render_to_output_buffer(context, output)\n88\t    rescue => exc\n89\t      blank_tag = !node.instance_of?(Variable) && node.blank?\n90\t      rescue_render_node(context, output, node.line_number, exc, blank_tag)\n91\t    end\n92\t\n93\t    # @api private\n94\t    def self.rescue_render_node(context, output, line_number, exc, blank_tag)\n95\t      case exc\n96\t      when MemoryError\n97\t        raise\n98\t      when UndefinedVariable, UndefinedDropMethod, UndefinedFilter\n99\t        context.handle_error(exc, line_number)\n100\t      else\n101\t        error_message = context.handle_error(exc, line_number)\n102\t        unless blank_tag # conditional for backwards compatibility\n103\t          output << error_message\n104\t        end\n105\t      end\n106\t    end\n107\t\n108\t    private def parse_liquid_tag(markup, parse_context)\n109\t      liquid_tag_tokenizer = parse_context.new_tokenizer(\n110\t        markup, start_line_number: parse_context.line_number, for_liquid_tag: true\n111\t      )\n112\t      parse_for_liquid_tag(liquid_tag_tokenizer, parse_context) do |end_tag_name, _end_tag_markup|\n113\t        if end_tag_name\n114\t          BlockBody.unknown_tag_in_liquid_tag(end_tag_name, parse_context)\n115\t        end\n116\t      end\n117\t    end\n118\t\n119\t    private def handle_invalid_tag_token(token, parse_context)\n120\t      if token.end_with?('%}')\n121\t        yield token, token\n122\t      else\n123\t        BlockBody.raise_missing_tag_terminator(token, parse_context)\n124\t      end\n125\t    end\n126\t\n127\t    OPEN_CURLEY_BYTE = 123 # '{'.ord\n128\t    PERCENT_BYTE = 37 # '%'.ord\n129\t\n130\t    # Fast check if string is whitespace-only (byte-level, avoids regex)\n131\t    def self.blank_string?(str)\n132\t      pos = 0\n133\t      len = str.bytesize\n134\t      while pos < len\n135\t        b = str.getbyte(pos)\n136\t        return false unless b == 32 || b == 9 || b == 10 || b == 13 || b == 12\n137\t        pos += 1\n138\t      end\n139\t      true\n140\t    end\n141\t\n142\t    private def parse_for_document(tokenizer, parse_context, &block)\n143\t      while (token = tokenizer.shift)\n144\t        next if token.empty?\n145\t\n146\t        first_byte = token.getbyte(0)\n147\t        if first_byte == OPEN_CURLEY_BYTE\n148\t          second_byte = token.getbyte(1)\n149\t          if second_byte == PERCENT_BYTE\n150\t            whitespace_handler(token, parse_context)\n151\t            cursor = parse_context.cursor\n152\t            tag_name = cursor.parse_tag_token(token)\n153\t            unless tag_name\n154\t              return handle_invalid_tag_token(token, parse_context, &block)\n155\t            end\n156\t            markup = cursor.tag_markup\n157\t\n158\t            if parse_context.line_number\n159\t              newlines = cursor.tag_newlines\n160\t              parse_context.line_number += newlines if newlines > 0\n161\t            end\n162\t\n163\t            if tag_name == 'liquid'\n164\t              parse_liquid_tag(markup, parse_context)\n165\t              next\n166\t            end\n167\t\n168\t            unless (tag = parse_context.environment.tag_for_name(tag_name))\n169\t              # end parsing if we reach an unknown tag and let the caller decide\n170\t              # determine how to proceed\n171\t              return yield tag_name, markup\n172\t            end\n173\t            new_tag = tag.parse(tag_name, markup, tokenizer, parse_context)\n174\t            @blank &&= new_tag.blank?\n175\t            @nodelist << new_tag\n176\t          elsif second_byte == OPEN_CURLEY_BYTE\n177\t            whitespace_handler(token, parse_context)\n178\t            @nodelist << create_variable(token, parse_context)\n179\t            @blank = false\n180\t          else\n181\t            # Fallback: text token starting with '{'\n182\t            if parse_context.trim_whitespace\n183\t              token.lstrip!\n184\t            end\n185\t            parse_context.trim_whitespace = false\n186\t            @nodelist << token\n187\t            @blank &&= BlockBody.blank_string?(token)\n188\t          end\n189\t        else\n190\t          if parse_context.trim_whitespace\n191\t            token.lstrip!\n192\t          end\n193\t          parse_context.trim_whitespace = false\n194\t          @nodelist << token\n195\t          @blank &&= BlockBody.blank_string?(token)\n196\t        end\n197\t        parse_context.line_number = tokenizer.line_number\n198\t      end\n199\t\n200\t      yield nil, nil\n201\t    end\n202\t\n203\t    DASH_BYTE = 45 # '-'.ord\n204\t\n205\t    def whitespace_handler(token, parse_context)\n206\t      if token.getbyte(2) == DASH_BYTE\n207\t        previous_token = @nodelist.last\n208\t        if previous_token.is_a?(String)\n209\t          first_byte = previous_token.getbyte(0)\n210\t          previous_token.rstrip!\n211\t          if previous_token.empty? && parse_context[:bug_compatible_whitespace_trimming] && first_byte\n212\t            previous_token << first_byte\n213\t          end\n214\t        end\n215\t      end\n216\t      parse_context.trim_whitespace = (token.getbyte(token.bytesize - 3) == DASH_BYTE)\n217\t    end\n218\t\n219\t    def blank?\n220\t      @blank\n221\t    end\n222\t\n223\t    # Remove blank strings in the block body for a control flow tag (e.g. `if`, `for`, `case`, `unless`)\n224\t    # with a blank body.\n225\t    #\n226\t    # For example, in a conditional assignment like the following\n227\t    #\n228\t    # ```\n229\t    # {% if size > max_size %}\n230\t    #   {% assign size = max_size %}\n231\t    # {% endif %}\n232\t    # ```\n233\t    #\n234\t    # we assume the intention wasn't to output the blank spaces in the `if` tag's block body, so this method\n235\t    # will remove them to reduce the render output size.\n236\t    #\n237\t    # Note that it is now preferred to use the `liquid` tag for this use case.\n238\t    def remove_blank_strings\n239\t      raise \"remove_blank_strings only support being called on a blank block body\" unless @blank\n240\t      @nodelist.reject! { |node| node.instance_of?(String) }\n241\t    end\n242\t\n243\t    def render(context)\n244\t      render_to_output_buffer(context, +'')\n245\t    end\n246\t\n247\t    def render_to_output_buffer(context, output)\n248\t      freeze unless frozen?\n249\t\n250\t      resource_limits = context.resource_limits\n251\t      nodelist = @nodelist\n252\t      resource_limits.increment_render_score(nodelist.length)\n253\t\n254\t      # Check if we need per-node write score tracking\n255\t      check_write = resource_limits.render_length_limit || resource_limits.last_capture_length\n256\t\n257\t      idx = 0\n258\t      if check_write\n259\t        while (node = nodelist[idx])\n260\t          if node.instance_of?(String)\n261\t            output << node\n262\t          else\n263\t            render_node(context, output, node)\n264\t            break if context.interrupt?\n265\t          end\n266\t          idx += 1\n267\t          resource_limits.increment_write_score(output)\n268\t        end\n269\t      else\n270\t        while (node = nodelist[idx])\n271\t          if node.instance_of?(String)\n272\t            output << node\n273\t          else\n274\t            render_node(context, output, node)\n275\t            break if context.interrupt?\n276\t          end\n277\t          idx += 1\n278\t        end\n279\t      end\n280\t\n281\t      output\n282\t    end\n283\t\n284\t    private\n285\t\n286\t    def render_node(context, output, node)\n287\t      BlockBody.render_node(context, output, node)\n288\t    end\n289\t\n290\t    CLOSE_CURLEY_BYTE = 125 # '}'.ord\n291\t\n292\t    # Cache entire Variable objects by their token string\n293\t    GLOBAL_VARIABLE_OBJECT_CACHE = {}\n294\t\n295\t    def create_variable(token, parse_context)\n296\t      len = token.bytesize\n297\t      if len >= 4 && token.getbyte(len - 1) == CLOSE_CURLEY_BYTE && token.getbyte(len - 2) == CLOSE_CURLEY_BYTE\n298\t        # Cache Variable objects — only when default error mode and cacheable\n299\t        em = parse_context.error_mode\n300\t        cacheable = parse_context.variable_cacheable && em != :strict && em != :strict2 && em != :rigid\n301\t        if cacheable && (cached = GLOBAL_VARIABLE_OBJECT_CACHE[token])\n302\t          return cached\n303\t        end\n304\t        markup = parse_context.cursor.parse_variable_token(token)\n305\t        var = Variable.new(markup, parse_context)\n306\t        GLOBAL_VARIABLE_OBJECT_CACHE[token] = var if cacheable\n307\t        return var\n308\t      end\n309\t\n310\t      BlockBody.raise_missing_variable_terminator(token, parse_context)\n311\t    end\n312\t\n313\t    # @deprecated Use {.raise_missing_tag_terminator} instead\n314\t    def raise_missing_tag_terminator(token, parse_context)\n315\t      BlockBody.raise_missing_tag_terminator(token, parse_context)\n316\t    end\n317\t\n318\t    # @deprecated Use {.raise_missing_variable_terminator} instead\n319\t    def raise_missing_variable_terminator(token, parse_context)\n320\t      BlockBody.raise_missing_variable_terminator(token, parse_context)\n321\t    end\n322\t  end\n323\tend\n324\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"e04d5301-fc8d-40ec-b861-611528d75216","timestamp":"2026-04-03T16:53:44.539Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0115M16rTMFCdoVChKnzXC4f","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\trequire 'set'\n4\t\n5\tmodule Liquid\n6\t  # StrainerTemplate is the computed class for the filters system.\n7\t  # New filters are mixed into the strainer class which is then instantiated for each liquid template render run.\n8\t  #\n9\t  # The Strainer only allows method calls defined in filters given to it via StrainerFactory.add_global_filter,\n10\t  # Context#add_filters or Template.register_filter\n11\t  class StrainerTemplate\n12\t    def initialize(context)\n13\t      @context = context\n14\t    end\n15\t\n16\t    class << self\n17\t      def add_filter(filter)\n18\t        return if include?(filter)\n19\t\n20\t        invokable_non_public_methods = (filter.private_instance_methods + filter.protected_instance_methods).select { |m| invokable?(m) }\n21\t        if invokable_non_public_methods.any?\n22\t          raise MethodOverrideError, \"Filter overrides registered public methods as non public: #{invokable_non_public_methods.join(', ')}\"\n23\t        end\n24\t\n25\t        include(filter)\n26\t\n27\t        filter_methods.merge(filter.public_instance_methods.map(&:to_s))\n28\t      end\n29\t\n30\t      def invokable?(method)\n31\t        filter_methods.include?(method.is_a?(String) ? method : method.to_s)\n32\t      end\n33\t\n34\t      def inherited(subclass)\n35\t        super\n36\t        subclass.instance_variable_set(:@filter_methods, @filter_methods.dup)\n37\t      end\n38\t\n39\t      def filter_method_names\n40\t        filter_methods.map(&:to_s).to_a\n41\t      end\n42\t\n43\t      private\n44\t\n45\t      def filter_methods\n46\t        @filter_methods ||= Set.new\n47\t      end\n48\t    end\n49\t\n50\t    def invoke(method, *args)\n51\t      if self.class.invokable?(method)\n52\t        send(method, *args)\n53\t      elsif @context.strict_filters\n54\t        raise Liquid::UndefinedFilter, \"undefined filter #{method}\"\n55\t      else\n56\t        args.first\n57\t      end\n58\t    rescue ::ArgumentError => e\n59\t      raise Liquid::ArgumentError, e.message, e.backtrace\n60\t    end\n61\t\n62\t    # Fast path for single-argument (no extra args) filter invocation.\n63\t    # Avoids *args splat allocation for the common {{ value | filter }} case.\n64\t    def invoke_single(method, input)\n65\t      if self.class.invokable?(method)\n66\t        send(method, input)\n67\t      elsif @context.strict_filters\n68\t        raise Liquid::UndefinedFilter, \"undefined filter #{method}\"\n69\t      else\n70\t        input\n71\t      end\n72\t    rescue ::ArgumentError => e\n73\t      raise Liquid::ArgumentError, e.message, e.backtrace\n74\t    end\n75\t\n76\t    # Fast path for three-argument filter invocation (input + two args).\n77\t    def invoke_three(method, input, arg1, arg2)\n78\t      if self.class.invokable?(method)\n79\t        send(method, input, arg1, arg2)\n80\t      elsif @context.strict_filters\n81\t        raise Liquid::UndefinedFilter, \"undefined filter #{method}\"\n82\t      else\n83\t        input\n84\t      end\n85\t    rescue ::ArgumentError => e\n86\t      raise Liquid::ArgumentError, e.message, e.backtrace\n87\t    end\n88\t\n89\t    # Invoke with pre-built args array — dispatches by count to avoid splat allocation\n90\t    def invoke_array(method, input, args)\n91\t      unless self.class.invokable?(method)\n92\t        if @context.strict_filters\n93\t          raise Liquid::UndefinedFilter, \"undefined filter #{method}\"\n94\t        end\n95\t        return input\n96\t      end\n97\t      case args.length\n98\t      when 0 then send(method, input)\n99\t      when 1 then send(method, input, args[0])\n100\t      when 2 then send(method, input, args[0], args[1])\n101\t      when 3 then send(method, input, args[0], args[1], args[2])\n102\t      else send(method, input, *args)\n103\t      end\n104\t    rescue ::ArgumentError => e\n105\t      raise Liquid::ArgumentError, e.message, e.backtrace\n106\t    end\n107\t\n108\t    # Fast path for two-argument filter invocation (input + one arg).\n109\t    def invoke_two(method, input, arg1)\n110\t      if self.class.invokable?(method)\n111\t        send(method, input, arg1)\n112\t      elsif @context.strict_filters\n113\t        raise Liquid::UndefinedFilter, \"undefined filter #{method}\"\n114\t      else\n115\t        input\n116\t      end\n117\t    rescue ::ArgumentError => e\n118\t      raise Liquid::ArgumentError, e.message, e.backtrace\n119\t    end\n120\t  end\n121\tend\n122\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"1d8fc9c5-f90e-4978-9ab3-a903f764701e","timestamp":"2026-04-03T16:53:44.515Z"}
