ank?\n44\t          body.freeze\n45\t        end\n46\t      end\n47\t      case_body.freeze\n48\t    end\n49\t\n50\t    def nodelist\n51\t      @blocks.map(&:attachment)\n52\t    end\n53\t\n54\t    def unknown_tag(tag, markup, tokens)\n55\t      case tag\n56\t      when 'when'\n57\t        record_when_condition(markup)\n58\t      when 'else'\n59\t        record_else_condition(markup)\n60\t      else\n61\t        super\n62\t      end\n63\t    end\n64\t\n65\t    def render_to_output_buffer(context, output)\n66\t      execute_else_block = true\n67\t\n68\t      @blocks.each do |block|\n69\t        if block.else?\n70\t          block.attachment.render_to_output_buffer(context, output) if execute_else_block\n71\t          next\n72\t        end\n73\t\n74\t        result = Liquid::Utils.to_liquid_value(\n75\t          block.evaluate(context),\n76\t        )\n77\t\n78\t        if result\n79\t          execute_else_block = false\n80\t          block.attachment.render_to_output_buffer(context, output)\n81\t        end\n82\t      end\n83\t\n84\t      output\n85\t    end\n86\t\n87\t    private\n88\t\n89\t    def strict2_parse(markup)\n90\t      parser = @parse_context.new_parser(markup)\n91\t      @left = safe_parse_expression(parser)\n92\t      parser.consume(:end_of_string)\n93\t    end\n94\t\n95\t    def strict_parse(markup)\n96\t      lax_parse(markup)\n97\t    end\n98\t\n99\t    def lax_parse(markup)\n100\t      if markup =~ Syntax\n101\t        @left = parse_expression(Regexp.last_match(1))\n102\t      else\n103\t        raise SyntaxError, options[:locale].t(\"errors.syntax.case\")\n104\t      end\n105\t    end\n106\t\n107\t    def record_when_condition(markup)\n108\t      body = new_body\n109\t\n110\t      if strict2_mode?\n111\t        parse_strict2_when(markup, body)\n112\t      else\n113\t        parse_lax_when(markup, body)\n114\t      end\n115\t    end\n116\t\n117\t    def parse_strict2_when(markup, body)\n118\t      parser = @parse_context.new_parser(markup)\n119\t\