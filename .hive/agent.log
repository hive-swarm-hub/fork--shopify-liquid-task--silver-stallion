       elsif byte == 46 # '.'\n60\t          pos += 1\n61\t        elsif (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95 || byte == 45 # \\w or -\n62\t          start = pos\n63\t          pos += 1\n64\t          while pos < len\n65\t            b = markup.getbyte(pos)\n66\t            break unless (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45\n67\t            pos += 1\n68\t          end\n69\t          # Check trailing '?'\n70\t          if pos < len && markup.getbyte(pos) == 63\n71\t            pos += 1\n72\t          end\n73\t          result << markup.byteslice(start, pos - start)\n74\t        else\n75\t          pos += 1\n76\t        end\n77\t      end\n78\t\n79\t      result\n80\t    end\n81\t\n82\t    # Check if markup is a simple identifier chain: [\\w-]+\\??(.[\\w-]+\\??)*\n83\t    # Uses C-level match? — 8x faster than Ruby byte scanning\n84\t    SIMPLE_LOOKUP_RE = /\\A[\\w-]+\\??(?:\\.[\\w-]+\\??)*\\z/\n85\t\n86\t    def self.simple_lookup?(markup)\n87\t      markup.bytesize > 0 && markup.match?(SIMPLE_LOOKUP_RE)\n88\t    end\n89\t\n90\t    def initialize(markup, string_scanner = StringScanner.new(\"\"), cache = nil, simple = false)\n91\t      # Fast path: simple identifier chain without brackets\n92\t      if simple || self.class.simple_lookup?(markup)\n93\t        dot_pos = markup.index('.')\n94\t        if dot_pos.nil?\n95\t          @name = markup\n96\t          @lookups = Const::EMPTY_ARRAY\n97\t          @command_flags = 0\n98\t          return\n99\t        end\n100\t        @name = markup.byteslice(0, dot_pos)\n101\t        mlen = markup.bytesize\n102\t        second_dot = markup.index('.', dot_pos + 1)\n103\t        if second_dot.nil?\n104\t          # Single-segment fast path: avoid Array allocation for \"a.b\" style (most common)\n105\t          seg = markup.byteslice(dot_pos + 1, mlen - dot_pos - 1)\n106\t          @command_flags = COMMAND_METHODS.