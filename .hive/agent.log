{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QggXNufQx32M2fNUGpszhn","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # Holds variables. Variables are only loaded \"just in time\"\n5\t  # and are not evaluated as part of the render stage\n6\t  #\n7\t  #   {{ monkey }}\n8\t  #   {{ user.name }}\n9\t  #\n10\t  # Variables can be combined with filters:\n11\t  #\n12\t  #   {{ user | link }}\n13\t  #\n14\t  class Variable\n15\t    # Checks if markup is a simple \"name.lookup.chain\" with no filters/brackets/quotes.\n16\t    # Returns the trimmed markup string, or nil if not simple.\n17\t    # Avoids regex MatchData allocation.\n18\t    def self.simple_variable_markup(markup)\n19\t      len = markup.bytesize\n20\t      return if len == 0\n21\t\n22\t      # Skip leading whitespace\n23\t      pos = 0\n24\t      while pos < len\n25\t        b = markup.getbyte(pos)\n26\t        break unless b == 32 || b == 9 || b == 10 || b == 13\n27\t        pos += 1\n28\t      end\n29\t      return if pos >= len\n30\t\n31\t      start = pos\n32\t\n33\t      # First char must be [a-zA-Z_]\n34\t      b = markup.getbyte(pos)\n35\t      return unless (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95\n36\t      pos += 1\n37\t\n38\t      # Scan segments: [\\w-]* (. [\\w-]*)*\n39\t      while pos < len\n40\t        b = markup.getbyte(pos)\n41\t        if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45\n42\t          pos += 1\n43\t        elsif b == 46 # '.'\n44\t          pos += 1\n45\t          # After dot, must have [a-zA-Z_]\n46\t          return if pos >= len\n47\t          b = markup.getbyte(pos)\n48\t          return unless (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95\n49\t          pos += 1\n50\t        else\n51\t          break\n52\t        end\n53\t      end\n54\t\n55\t      content_end = pos\n56\t\n57\t      # Skip trailing whitespace\n58\t      while pos < len\n59\t        b = markup.getbyte(pos)\n60\t        return unless b == 32 || b == 9 || b == 10 || b == 13\n61\t        pos += 1\n62\t      end\n63\t\n64\t      # Must have consumed everything\n65\t      return unless pos == len\n66\t\n67\t      if start == 0 && content_end == len\n68\t        markup\n69\t      else\n70\t        markup.byteslice(start, content_end - start)\n71\t      end\n72\t    end\n73\t\n74\t    FILTER_NAME_INTERN = Hash.new { |h, k| h[k] = k.freeze }\n75\t\n76\t    # Integer-key lookup for common filter names (avoids byteslice allocation)\n77\t    FILTER_INT_KEYS = {}\n78\t    %w[escape money json size first last default date strip_html\n79\t       truncatewords upcase downcase capitalize strip lstrip rstrip\n80\t       replace split join sort reverse map compact uniq\n81\t       abs ceil floor round plus minus times divided_by modulo\n82\t       append prepend remove remove_first replace_first slice\n83\t       truncate url_encode url_decode newline_to_br strip_newlines\n84\t       img_tag script_tag stylesheet_tag link_to].each do |name|\n85\t      next if name.bytesize > 7\n86\t      key = 0\n87\t      name.each_byte { |b| key = (key << 8) | b }\n88\t      FILTER_INT_KEYS[key] = name.freeze\n89\t    end\n90\t    FILTER_INT_KEYS.freeze\n91\t\n92\t    # Cache for [filtername, EMPTY_ARRAY] tuples — avoids repeated array creation\n93\t    NO_ARG_FILTER_CACHE = Hash.new { |h, k| h[k] = [k, Const::EMPTY_ARRAY].freeze }\n94\t\n95\t    SINGLE_NO_ARG_FILTER_CACHE = Hash.new { |h, k| h[k] = [NO_ARG_FILTER_CACHE[k]].freeze }\n96\t\n97\t    # Global cache for variable parse state (markup → [name, filters]).\n98\t    GLOBAL_VARIABLE_STATE_CACHE = {}\n99\t\n100\t    FilterMarkupRegex        = /#{FilterSeparator}\\s*(.*)/om\n101\t    FilterParser             = /(?:\\s+|#{QuotedFragment}|#{ArgumentSeparator})+/o\n102\t    FilterArgsRegex          = /(?:#{FilterArgumentSeparator}|#{ArgumentSeparator})\\s*((?:\\w+\\s*\\:\\s*)?#{QuotedFragment})/o\n103\t    JustTagAttributes        = /\\A#{TagAttributes}\\z/o\n104\t    MarkupWithQuotedFragment = /(#{QuotedFragment})(.*)/om\n105\t\n106\t    attr_accessor :filters, :name, :line_number\n107\t    attr_reader :parse_context\n108\t    alias_method :options, :parse_context\n109\t\n110\t    include ParserSwitching\n111\t\n112\t    def initialize(markup, parse_context)\n113\t      @markup        = markup\n114\t      @name          = nil\n115\t      @parse_context = parse_context\n116\t      @line_number   = parse_context.line_number\n117\t\n118\t      # Fast path: try to parse without going through Lexer → Parser\n119\t      # Skip for strict2/rigid modes which require different parsing\n120\t      # Fast path only for lax/warn modes — strict modes need full error checking\n121\t      error_mode = parse_context.error_mode\n122\t      if error_mode == :strict2 || error_mode == :rigid || error_mode == :strict || !try_fast_parse(markup, parse_context)\n123\t        strict_parse_with_error_mode_fallback(markup)\n124\t      end\n125\t    end\n126\t\n127\t    private def try_fast_parse(markup, parse_context)\n128\t      len = markup.bytesize\n129\t      return false if len == 0\n130\t\n131\t      # Check global variable state cache\n132\t      if parse_context.variable_cacheable && (cached = GLOBAL_VARIABLE_STATE_CACHE[markup])\n133\t        @name    = cached[0]\n134\t        @filters = cached[1]\n135\t        return true\n136\t      end\n137\t\n138\t      # Skip leading whitespace\n139\t      pos = 0\n140\t      while pos < len\n141\t        b = markup.getbyte(pos)\n142\t        break unless b == 32 || b == 9 || b == 10 || b == 13\n143\t        pos += 1\n144\t      end\n145\t      return false if pos >= len\n146\t\n147\t      b = markup.getbyte(pos)\n148\t\n149\t      if b == 39 || b == 34 # single or double quote\n150\t        # Quoted string literal: scan to matching close quote\n151\t        quote = b\n152\t        name_start = pos\n153\t        pos += 1\n154\t        pos += 1 while pos < len && markup.getbyte(pos) != quote\n155\t        pos += 1 if pos < len # skip closing quote\n156\t        name_end = pos\n157\t      elsif (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95\n158\t        # Identifier: scan [\\w-]*(\\.[\\w-]*)*\n159\t        name_start = pos\n160\t        pos += 1\n161\t        while pos < len\n162\t          b = markup.getbyte(pos)\n163\t          if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45\n164\t            pos += 1\n165\t          elsif b == 46 # '.'\n166\t            pos += 1\n167\t            return false if pos >= len\n168\t            b = markup.getbyte(pos)\n169\t            return false unless (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95\n170\t            pos += 1\n171\t          else\n172\t            break\n173\t          end\n174\t        end\n175\t        name_end = pos\n176\t      else\n177\t        return false\n178\t      end\n179\t\n180\t      # Skip whitespace after name\n181\t      while pos < len\n182\t        b = markup.getbyte(pos)\n183\t        break unless b == 32 || b == 9 || b == 10 || b == 13\n184\t        pos += 1\n185\t      end\n186\t\n187\t      # Resolve the name expression — avoid byteslice when markup is already the name\n188\t      expr_markup = if name_start == 0 && name_end == len\n189\t        markup # no whitespace, no filters — reuse the string\n190\t      else\n191\t        markup.byteslice(name_start, name_end - name_start)\n192\t      end\n193\t      cache = parse_context.expression_cache\n194\t      ss = parse_context.string_scanner\n195\t\n196\t      first_byte = expr_markup.getbyte(0)\n197\t      @name = if first_byte == 39 || first_byte == 34 # quoted string\n198\t        # Strip quotes for string literal\n199\t        expr_markup.byteslice(1, expr_markup.bytesize - 2)\n200\t      elsif Expression::LITERALS.key?(expr_markup)\n201\t        Expression::LITERALS[expr_markup]\n202\t      elsif cache\n203\t        if (hit = cache[expr_markup])\n204\t          hit\n205\t        else\n206\t          hit = VariableLookup.parse_simple(expr_markup, ss, cache).freeze\n207\t          cache[expr_markup] = hit\n208\t          hit\n209\t        end\n210\t      else\n211\t        VariableLookup.parse_simple(expr_markup, ss || StringScanner.new(\"\"), nil).freeze\n212\t      end\n213\t\n214\t      # End of markup? No filters.\n215\t      if pos >= len\n216\t        @filters = Const::EMPTY_ARRAY\n217\t        return true\n218\t      end\n219\t\n220\t      # Must be a pipe for filters\n221\t      return false unless markup.getbyte(pos) == 124 # '|'\n222\t\n223\t      # Try fast filter scanning first — handles no-arg and simple-arg filters\n224\t      # Falls through to Lexer-based parsing for complex cases\n225\t      first_filter = nil\n226\t      @filters = nil\n227\t      filter_pos = pos\n228\t\n229\t      while filter_pos < len && markup.getbyte(filter_pos) == 124 # '|'\n230\t        filter_pos += 1\n231\t        # Skip whitespace\n232\t        filter_pos += 1 while filter_pos < len && markup.getbyte(filter_pos) == 32\n233\t\n234\t        # Scan filter name\n235\t        fname_start = filter_pos\n236\t        b = filter_pos < len ? markup.getbyte(filter_pos) : nil\n237\t        break unless b && ((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95)\n238\t        filter_pos += 1\n239\t        while filter_pos < len\n240\t          b = markup.getbyte(filter_pos)\n241\t          break unless (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45\n242\t          filter_pos += 1\n243\t        end\n244\t        fname_len = filter_pos - fname_start\n245\t        filtername = nil\n246\t        if fname_len <= 7\n247\t          fkey = 0\n248\t          fj = fname_start\n249\t          while fj < filter_pos\n250\t            fkey = (fkey << 8) | markup.getbyte(fj)\n251\t            fj += 1\n252\t          end\n253\t          filtername = FILTER_INT