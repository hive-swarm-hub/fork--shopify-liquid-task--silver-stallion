{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014frNuGwzcpds5PzapDfgTP","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # Context keeps the variable stack and resolves variables, as well as keywords\n5\t  #\n6\t  #   context['variable'] = 'testing'\n7\t  #   context['variable'] #=> 'testing'\n8\t  #   context['true']     #=> true\n9\t  #   context['10.2232']  #=> 10.2232\n10\t  #\n11\t  #   context.stack do\n12\t  #      context['bob'] = 'bobsen'\n13\t  #   end\n14\t  #\n15\t  #   context['bob']  #=> nil  class Context\n16\t  class Context\n17\t    attr_reader :scopes, :errors, :registers, :environments, :resource_limits, :static_registers, :static_environments\n18\t    attr_accessor :exception_renderer, :template_name, :partial, :global_filter, :strict_variables, :strict_filters, :environment\n19\t\n20\t    # rubocop:disable Metrics/ParameterLists\n21\t    def self.build(environment: Environment.default, environments: {}, outer_scope: {}, registers: {}, rethrow_errors: false, resource_limits: nil, static_environments: {}, &block)\n22\t      new(environments, outer_scope, registers, rethrow_errors, resource_limits, static_environments, environment, &block)\n23\t    end\n24\t\n25\t    def initialize(environments = {}, outer_scope = {}, registers = {}, rethrow_errors = false, resource_limits = nil, static_environments = {}, environment = Environment.default)\n26\t      @environment = environment\n27\t      @environments = environments.is_a?(Array) ? environments : [environments]\n28\t\n29\t      @static_environments = if static_environments.is_a?(Array)\n30\t        static_environments.frozen? ? static_environments : static_environments.freeze\n31\t      elsif static_environments.empty?\n32\t        Const::EMPTY_ARRAY\n33\t      else\n34\t        [static_environments].freeze\n35\t      end\n36\t      @scopes              = [outer_scope || {}]\n37\t      @registers           = registers.is_a?(Registers) ? registers : Registers.new(registers)\n38\t      @errors              = Const::EMPTY_ARRAY\n39\t      @partial             = false\n40\t      @strict_variables    = false\n41\t      @resource_limits     = resource_limits || ResourceLimits.new(environment.default_resource_limits)\n42\t      @base_scope_depth    = 0\n43\t      @interrupts          = Const::EMPTY_ARRAY\n44\t      @filters             = Const::EMPTY_ARRAY\n45\t      @global_filter       = nil\n46\t      @disabled_tags       = Const::EMPTY_HASH\n47\t\n48\t      # Lazy-init StringScanner — only needed if Context#[] is called during render\n49\t      @string_scanner = nil\n50\t\n51\t      @registers.static[:cached_partials] ||= {}\n52\t      @registers.static[:file_system] ||= environment.file_system\n53\t      @registers.static[:template_factory] ||= Liquid::TemplateFactory.new\n54\t\n55\t      self.exception_renderer = environment.exception_renderer\n56\t      if rethrow_errors\n57\t        self.exception_renderer = Liquid::RAISE_EXCEPTION_LAMBDA\n58\t      end\n59\t\n60\t      yield self if block_given?\n61\t\n62\t      # Do this last, since it could result in this object being passed to a Proc in the environment\n63\t      squash_instance_assigns_with_environments\n64\t    end\n65\t    # rubocop:enable Metrics/ParameterLists\n66\t\n67\t    def warnings\n68\t      @warnings ||= []\n69\t    end\n70\t\n71\t    def strainer\n72\t      @strainer ||= @environment.create_strainer(self, @filters)\n73\t    end\n74\t\n75\t    # Adds filters to this context.\n76\t    #\n77\t    # Note that this does not register the filters with the main Template object. see <tt>Template.register_filter</tt>\n78\t    # for that\n79\t    def add_filters(filters)\n80\t      filters = [filters].flatten.compact\n81\t      @filters += filters\n82\t      @strainer = nil\n83\t    end\n84\t\n85\t    def apply_global_filter(obj)\n86\t      global_filter.nil? ? obj : global_filter.call(obj)\n87\t    end\n88\t\n89\t    # are there any not handled interrupts?\n90\t    def interrupt?\n91\t      !@interrupts.frozen? && !@interrupts.empty?\n92\t    end\n93\t\n94\t    # push an interrupt to the stack. this interrupt is considered not handled.\n95\t    def push_interrupt(e)\n96\t      @interrupts = [] if @interrupts.frozen?\n97\t      @interrupts.push(e)\n98\t    end\n99\t\n100\t    # pop an interrupt from the stack\n101\t    def pop_interrupt\n102\t      @interrupts.pop\n103\t    end\n104\t\n105\t    def handle_error(e, line_number = nil)\n106\t      e = internal_error unless e.is_a?(Liquid::Error)\n107\t      e.template_name ||= template_name\n108\t      e.line_number   ||= line_number\n109\t      @errors = [] if @errors.frozen?\n110\t      @errors.push(e)\n111\t      exception_renderer.call(e).to_s\n112\t    end\n113\t\n114\t    def invoke(method, *args)\n115\t      result = strainer.invoke(method, *args)\n116\t      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n117\t        result\n118\t      else\n119\t        result.to_liquid\n120\t      end\n121\t    end\n122\t\n123\t    # Fast path for three-argument filter invocation (input + two args)\n124\t    def invoke_three(method, input, arg1, arg2)\n125\t      result = strainer.invoke_three(method, input, arg1, arg2)\n126\t      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n127\t        result\n128\t      else\n129\t        result.to_liquid\n130\t      end\n131\t    end\n132\t\n133\t    # Invoke filter with pre-built args array — avoids splat allocation\n134\t    def invoke_array(method, input, args)\n135\t      result = strainer.invoke_array(method, input, args)\n136\t      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n137\t        result\n138\t      else\n139\t        result.to_liquid\n140\t      end\n141\t    end\n142\t\n143\t    # Fast path for single-argument filter invocation (the most common case:\n144\t    # {{ value | filter }}) — avoids *args splat allocation.\n145\t    def invoke_single(method, input)\n146\t      result = strainer.invoke_single(method, input)\n147\t      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n148\t        result\n149\t      else\n150\t        result.to_liquid\n151\t      end\n152\t    end\n153\t\n154\t    # Fast path for two-argument filter invocation (e.g. {{ value | default: 'x' }})\n155\t    def invoke_two(method, input, arg1)\n156\t      result = strainer.invoke_two(method, input, arg1)\n157\t      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n158\t        result\n159\t      else\n160\t        result.to_liquid\n161\t      end\n162\t    end\n163\t\n164\t    # Push new local scope on the stack. use <tt>Context#stack</tt> instead\n165\t    def push(new_scope = {})\n166\t      @scopes.unshift(new_scope)\n167\t      check_overflow\n168\t    end\n169\t\n170\t    # Merge a hash of variables in the current local scope\n171\t    def merge(new_scopes)\n172\t      @scopes[0].merge!(new_scopes)\n173\t    end\n174\t\n175\t    # Pop from the stack. use <tt>Context#stack</tt> instead\n176\t    def pop\n177\t      raise ContextError if @scopes.size == 1\n178\t      @scopes.shift\n179\t    end\n180\t\n181\t    # Pushes a new local scope on the stack, pops it at the end of the block\n182\t    #\n183\t    # Example:\n184\t    #   context.stack do\n185\t    #      context['var'] = 'hi'\n186\t    #   end\n187\t    #\n188\t    #   context['var']  #=> nil\n189\t    def stack(new_scope = {})\n190\t      push(new_scope)\n191\t      yield\n192\t    ensure\n193\t      pop\n194\t    end\n195\t\n196\t    # Creates a new context inheriting resource limits, filters, environment etc.,\n197\t    # but with an isolated scope.\n198\t    def new_isolated_subcontext\n199\t      check_overflow\n200\t\n201\t      self.class.build(\n202\t        environment: @environment,\n203\t        resource_limits: resource_limits,\n204\t        static_environments: static_environments,\n205\t        registers: Registers.new(registers),\n206\t      ).tap do |subcontext|\n207\t        subcontext.base_scope_depth   = base_scope_depth + 1\n208\t        subcontext.exception_renderer = exception_renderer\n209\t        subcontext.filters  = @filters\n210\t        subcontext.strainer = nil\n211\t        subcontext.errors   = errors\n212\t        subcontext.warnings = warnings\n213\t        subcontext.disabled_tags = @disabled_tags\n214\t      end\n215\t    end\n216\t\n217\t    def clear_instance_assigns\n218\t      @scopes[0] = {}\n219\t    end\n220\t\n221\t    # Only allow String, Numeric, Hash, Array, Proc, Boolean or <tt>Liquid::Drop</tt>\n222\t    def []=(key, value)\n223\t      @scopes[0][key] = value\n224\t    end\n225\t\n226\t    # Look up variable, either resolve directly after considering the name. We can directly handle\n227\t    # Strings, digits, floats and booleans (true,false).\n228\t    # If no match is made we lookup the variable in the current scope and\n229\t    # later move up to the parent blocks to see if we can resolve the variable somewhere up the tree.\n230\t    # Some special keywords return symbols. Those symbols are to be called on the rhs object in expressions\n231\t    #\n232\t    # Example:\n233\t    #   products == empty #=> products.empty?\n234\t    def [](expression)\n235\t      evaluate(Expression.parse(expression, @string_scanner ||= StringScanner.new(\"\")))\n236\t    end\n237\t\n238\t    def key?(key)\n239\t      find_variable(key, raise_on_not_found: false) != nil\n240\t    end\n241\t\n242\t    def evaluate(object)\n243\t      return object if object.instance_of?(String) || object.instance_of?(Integer)\n244\t      object.respond_to?(:evaluate) ? object.evaluate(self) : object\n245\t    end\n246\t\n247\t    # Fetches an object starting at the local scope and then moving up the hierachy\n248\t    def find_variable(key, raise_on_not_found: true)\n249\t      # Fast path: check top scope first (most common in for loops)\n250\t      scope = @scopes[0]\n251\t      if scope.key?(key)\n252\t        variable = lookup_and_evaluate(scope, key, raise_on_not_found: raise_on_not_found)\n253\t      elsif @scopes.length == 1\n254\t        # Only one scope and key not found — go straight to environments\n255\t        variable = try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n256\t      else\n257\t        # Multiple scopes — search through all of them\n258\t        scopes = @scopes\n259\t        found_scope = nil\n260\t        i = 1\n261\t        len = scopes.length\n262\t        while i < len\n263\t          if scopes[i].key?(key)\n264\t            found_scope = scopes[i]\n265\t            break\n266\t          end\n267\t          i += 1\n268\t        end\n269\t\n270\t        variable = if found_scope\n271\t          lookup_and_evaluate(found_scope, key, raise_on_not_found: raise_on_not_found)\n272\t        else\n273\t          try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n274\t        end\n275\t      end\n276\t\n277\t      # update variable's context before invoking #to_liquid\n278\t      # Fast path: primitive types don't need context= or to_liquid conversion\n279\t      case variable\n280\t      when String, Integer, Float, NilClass, TrueClass, FalseClass\n281\t        return variable\n282\t      when Array, Hash, Time\n283\t        return variable\n284\t      end\n285\t\n286\t      variable.context = self if variable.respond_to?(:context=)\n287\t\n288\t      liquid_variable = variable.to_liquid\n289\t\n290\t      if variable != liquid_variable\n291\t        liquid_variable.context = self if liquid_variable.respond_to?(:context=)\n292\t      end\n293\t\n294\t      liquid_variable\n295\t    end\n296\t\n297\t    def lookup_and_evaluate(obj, key, raise_on_not_found: true)\n298\t      value = obj[key]\n299\t\n300\t      if value.nil? && @strict_variables && raise_on_not_found && obj.respond_to?(:key?) && !obj.key?(key)\n301\t        raise Liquid::UndefinedVariable, \"undefined variable #{key}\"\n302\t      end\n303\t\n304\t      if value.instance_of?(Proc) && obj.respond_to?(:[]=)\n305\t        obj[key] = value.arity == 0 ? value.call : value.call(self)\n306\t      else\n307\t        value\n308\t      end\n309\t    end\n310\t\n311\t    def with_disabled_tags(tag_names)\n312\t      @disabled_tags = {} if @disabled_tags.frozen?\n313\t      tag_names.each do |name|\n314\t        @disabled_tags[name] = @disabled_tags.fetch(name, 0) + 1\n315\t      end\n316\t      yield\n317\t    ensure\n318\t      tag_names.each do |name|\n319\t        @disabled_tags[name] -= 1\n320\t      end\n321\t    end\n322\t\n323\t    def tag_disabled?(tag_name)\n324\t      @disabled_tags.fetch(tag_name, 0) > 0\n325\t    end\n326\t\n327\t    protected\n328\t\n329\t    attr_writer :base_scope_depth, :warnings, :errors, :strainer, :filters, :disabled_tags\n330\t\n331\t    private\n332\t\n333\t    attr_reader :base_scope_depth\n334\t\n335\t    def try_variable_find_in_environments(key, raise_on_not_found:)\n336\t      envs = @environments\n337\t      i = 0\n338\t      len = envs.length\n339\t      while i < len\n340\t        found_variable = lookup_and_evaluate(envs[i], key, raise_on_not_found: raise_on_not_found)\n341\t        if !found_variable.nil? || @strict_variables && raise_on_not_found\n342\t          return found_variable\n343\t        end\n344\t        i += 1\n345\t      end\n346\t      static_envs = @static_environments\n347\t      i = 0\n348\t      len = static_envs.length\n349\t      while i < len\n350\t        found_variable = lookup_and_evaluate(static_envs[i], key, raise_on_not_found: raise_on_not_found)\n351\t        if !found_variable.nil? || @strict_variables && raise_on_not_found\n352\t          return found_variable\n353\t        end\n354\t        i += 1\n355\t      end\n356\t      nil\n357\t    end\n358\t\n359\t    def check_overflow\n360\t      raise StackLevelError, \"Nesting too deep\" if overflow?\n361\t    end\n362\t\n363\t    def overflow?\n364\t      base_scope_depth + @scopes.length > Block::MAX_DEPTH\n365\t    end\n366\t\n367\t    def internal_error\n368\t      # raise and catch to set backtrace and cause on exception\n369\t      raise Liquid::InternalError, 'internal'\n370\t    rescue Liquid::InternalError => exc\n371\t      exc\n372\t    end\n373\t\n374\t    def squash_instance_assigns_with_environments\n375\t      @scopes.last.each_key do |k|\n376\t        @environments.each do |env|\n377\t          if env.key?(k)\n378\t            scopes.last[k] = lookup_and_evaluate(env, k)\n379\t            break\n380\t          end\n381\t        end\n382\t      end\n383\t    end # squash_instance_assigns_with_environments\n384\t  end # Context\n385\tend # Liquid\n386\t"}]},"parent_tool_use_id":null,"session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"b43bb549-3d73-4544-b53f-b4380f5f2cd1","timestamp":"2026-04-03T16:54:25.072Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/hive-swarm/shopify-liquid-task/silver-stallion/lib/liquid/context.rb","content":"# frozen_string_literal: true\n\nmodule Liquid\n  # Context keeps the variable stack and resolves variables, as well as keywords\n  #\n  #   context['variable'] = 'testing'\n  #   context['variable'] #=> 'testing'\n  #   context['true']     #=> true\n  #   context['10.2232']  #=> 10.2232\n  #\n  #   context.stack do\n  #      context['bob'] = 'bobsen'\n  #   end\n  #\n  #   context['bob']  #=> nil  class Context\n  class Context\n    attr_reader :scopes, :errors, :registers, :environments, :resource_limits, :static_registers, :static_environments\n    attr_accessor :exception_renderer, :template_name, :partial, :global_filter, :strict_variables, :strict_filters, :environment\n\n    # rubocop:disable Metrics/ParameterLists\n    def self.build(environment: Environment.default, environments: {}, outer_scope: {}, registers: {}, rethrow_errors: false, resource_limits: nil, static_environments: {}, &block)\n      new(environments, outer_scope, registers, rethrow_errors, resource_limits, static_environments, environment, &block)\n    end\n\n    def initialize(environments = {}, outer_scope = {}, registers = {}, rethrow_errors = false, resource_limits = nil, static_environments = {}, environment = Environment.default)\n      @environment = environment\n      @environments = environments.is_a?(Array) ? environments : [environments]\n\n      @static_environments = if static_environments.is_a?(Array)\n        static_environments.frozen? ? static_environments : static_environments.freeze\n      elsif static_environments.empty?\n        Const::EMPTY_ARRAY\n      else\n        [static_environments].freeze\n      end\n      @scopes              = [outer_scope || {}]\n      @registers           = registers.is_a?(Registers) ? registers : Registers.new(registers)\n      @errors              = Const::EMPTY_ARRAY\n      @partial             = false\n      @strict_variables    = false\n      @resource_limits     = resource_limits || ResourceLimits.new(environment.default_resource_limits)\n      @base_scope_depth    = 0\n      @interrupts          = Const::EMPTY_ARRAY\n      @filters             = Const::EMPTY_ARRAY\n      @global_filter       = nil\n      @disabled_tags       = Const::EMPTY_HASH\n\n      # Lazy-init StringScanner — only needed if Context#[] is called during render\n      @string_scanner = nil\n\n      @registers.static[:cached_partials] ||= {}\n      @registers.static[:file_system] ||= environment.file_system\n      @registers.static[:template_factory] ||= Liquid::TemplateFactory.new\n\n      self.exception_renderer = environment.exception_renderer\n      if rethrow_errors\n        self.exception_renderer = Liquid::RAISE_EXCEPTION_LAMBDA\n      end\n\n      yield self if block_given?\n\n      # Do this last, since it could result in this object being passed to a Proc in the environment\n      squash_instance_assigns_with_environments\n    end\n    # rubocop:enable Metrics/ParameterLists\n\n    def warnings\n      @warnings ||= []\n    end\n\n    def strainer\n      @strainer ||= @environment.create_strainer(self, @filters)\n    end\n\n    # Adds filters to this context.\n    #\n    # Note that this does not register the filters with the main Template object. see <tt>Template.register_filter</tt>\n    # for that\n    def add_filters(filters)\n      filters = [filters].flatten.compact\n      @filters += filters\n      @strainer = nil\n    end\n\n    def apply_global_filter(obj)\n      global_filter.nil? ? obj : global_filter.call(obj)\n    end\n\n    # are there any not handled interrupts?\n    def interrupt?\n      !@interrupts.frozen? && !@interrupts.empty?\n    end\n\n    # push an interrupt to the stack. this interrupt is considered not handled.\n    def push_interrupt(e)\n      @interrupts = [] if @interrupts.frozen?\n      @interrupts.push(e)\n    end\n\n    # pop an interrupt from the stack\n    def pop_interrupt\n      @interrupts.pop\n    end\n\n    def handle_error(e, line_number = nil)\n      e = internal_error unless e.is_a?(Liquid::Error)\n      e.template_name ||= template_name\n      e.line_number   ||= line_number\n      @errors = [] if @errors.frozen?\n      @errors.push(e)\n      exception_renderer.call(e).to_s\n    end\n\n    def invoke(method, *args)\n      result = strainer.invoke(method, *args)\n      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n        result\n      else\n        result.to_liquid\n      end\n    end\n\n    # Fast path for three-argument filter invocation (input + two args)\n    def invoke_three(method, input, arg1, arg2)\n      result = strainer.invoke_three(method, input, arg1, arg2)\n      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n        result\n      else\n        result.to_liquid\n      end\n    end\n\n    # Invoke filter with pre-built args array — avoids splat allocation\n    def invoke_array(method, input, args)\n      result = strainer.invoke_array(method, input, args)\n      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n        result\n      else\n        result.to_liquid\n      end\n    end\n\n    # Fast path for single-argument filter invocation (the most common case:\n    # {{ value | filter }}) — avoids *args splat allocation.\n    def invoke_single(method, input)\n      result = strainer.invoke_single(method, input)\n      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n        result\n      else\n        result.to_liquid\n      end\n    end\n\n    # Fast path for two-argument filter invocation (e.g. {{ value | default: 'x' }})\n    def invoke_two(method, input, arg1)\n      result = strainer.invoke_two(method, input, arg1)\n      if result.instance_of?(String) || result.instance_of?(Integer) || result.instance_of?(Float) || result.nil?\n        result\n      else\n        result.to_liquid\n      end\n    end\n\n    # Push new local scope on the stack. use <tt>Context#stack</tt> instead\n    def push(new_scope = {})\n      @scopes.unshift(new_scope)\n      check_overflow\n    end\n\n    # Merge a hash of variables in the current local scope\n    def merge(new_scopes)\n      @scopes[0].merge!(new_scopes)\n    end\n\n    # Pop from the stack. use <tt>Context#stack</tt> instead\n    def pop\n      raise ContextError if @scopes.size == 1\n      @scopes.shift\n    end\n\n    # Pushes a new local scope on the stack, pops it at the end of the block\n    #\n    # Example:\n    #   context.stack do\n    #      context['var'] = 'hi'\n    #   end\n    #\n    #   context['var']  #=> nil\n    def stack(new_scope = {})\n      push(new_scope)\n      yield\n    ensure\n      pop\n    end\n\n    # Creates a new context inheriting resource limits, filters, environment etc.,\n    # but with an isolated scope.\n    def new_isolated_subcontext\n      check_overflow\n\n      self.class.build(\n        environment: @environment,\n        resource_limits: resource_limits,\n        static_environments: static_environments,\n        registers: Registers.new(registers),\n      ).tap do |subcontext|\n        subcontext.base_scope_depth   = base_scope_depth + 1\n        subcontext.exception_renderer = exception_renderer\n        subcontext.filters  = @filters\n        subcontext.strainer = nil\n        subcontext.errors   = errors\n        subcontext.warnings = warnings\n        subcontext.disabled_tags = @disabled_tags\n      end\n    end\n\n    def clear_instance_assigns\n      @scopes[0] = {}\n    end\n\n    # Only allow String, Numeric, Hash, Array, Proc, Boolean or <tt>Liquid::Drop</tt>\n    def []=(key, value)\n      @scopes[0][key] = value\n    end\n\n    # Look up variable, either resolve directly after considering the name. We can directly handle\n    # Strings, digits, floats and booleans (true,false).\n    # If no match is made we lookup the variable in the current scope and\n    # later move up to the parent blocks to see if we can resolve the variable somewhere up the tree.\n    # Some special keywords return symbols. Those symbols are to be called on the rhs object in expressions\n    #\n    # Example:\n    #   products == empty #=> products.empty?\n    def [](expression)\n      evaluate(Expression.parse(expression, @string_scanner ||= StringScanner.new(\"\")))\n    end\n\n    def key?(key)\n      find_variable(key, raise_on_not_found: false) != nil\n    end\n\n    def evaluate(object)\n      return object if object.instance_of?(String) || object.instance_of?(Integer)\n      object.respond_to?(:evaluate) ? object.evaluate(self) : object\n    end\n\n    # Fetches an object starting at the local scope and then moving up the hierachy\n    def find_variable(key, raise_on_not_found: true)\n      # Fast path: check top scope first (most common in for loops)\n      scope = @scopes[0]\n      if scope.key?(key)\n        variable = lookup_and_evaluate(scope, key, raise_on_not_found: raise_on_not_found)\n      elsif @scopes.length == 1\n        # Only one scope and key not found — go straight to environments\n        variable = try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n      else\n        # Multiple scopes — search through all of them\n        scopes = @scopes\n        found_scope = nil\n        i = 1\n        len = scopes.length\n        while i < len\n          if scopes[i].key?(key)\n            found_scope = scopes[i]\n            break\n          end\n          i += 1\n        end\n\n        variable = if found_scope\n          lookup_and_evaluate(found_scope, key, raise_on_not_found: raise_on_not_found)\n        else\n          try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n        end\n      end\n\n      # update variable's context before invoking #to_liquid\n      # Fast path: primitive types don't need context= or to_liquid conversion\n      case variable\n      when String, Integer, Float, NilClass, TrueClass, FalseClass\n        return variable\n      when Array, Hash, Time\n        return variable\n      end\n\n      variable.context = self if variable.respond_to?(:context=)\n\n      liquid_variable = variable.to_liquid\n\n      if variable != liquid_variable\n        liquid_variable.context = self if liquid_variable.respond_to?(:context=)\n      end\n\n      liquid_variable\n    end\n\n    def lookup_and_evaluate(obj, key, raise_on_not_found: true)\n      value = obj[key]\n\n      if value.nil? && @strict_variables && raise_on_not_found && obj.respond_to?(:key?) && !obj.key?(key)\n        raise Liquid::UndefinedVariable, \"undefined variable #{key}\"\n      end\n\n      if value.instance_of?(Proc) && obj.respond_to?(:[]=)\n        obj[key] = value.arity == 0 ? value.call : value.call(self)\n      else\n        value\n      end\n    end\n\n    def with_disabled_tags(tag_names)\n      @disabled_tags = {} if @disabled_tags.frozen?\n      tag_names.each do |name|\n        @disabled_tags[name] = @disabled_tags.fetch(name, 0) + 1\n      end\n      yield\n    ensure\n      tag_names.each do |name|\n        @disabled_tags[name] -= 1\n      end\n    end\n\n    def tag_disabled?(tag_name)\n      @disabled_tags.fetch(tag_name, 0) > 0\n    end\n\n    protected\n\n    attr_writer :base_scope_depth, :warnings, :errors, :strainer, :filters, :disabled_tags\n\n    private\n\n    attr_reader :base_scope_depth\n\n    def try_variable_find_in_environments(key, raise_on_not_found:)\n      envs = @environments\n      i = 0\n      len = envs.length\n      while i < len\n        found_variable = lookup_and_evaluate(envs[i], key, raise_on_not_found: raise_on_not_found)\n        if !found_variable.nil? || @strict_variables && raise_on_not_found\n          return found_variable\n        end\n        i += 1\n      end\n      static_envs = @static_environments\n      i = 0\n      len = static_envs.length\n      while i < len\n        found_variable = lookup_and_evaluate(static_envs[i], key, raise_on_not_found: raise_on_not_found)\n        if !found_variable.nil? || @strict_variables && raise_on_not_found\n          return found_variable\n        end\n        i += 1\n      end\n      nil\n    end\n\n    def check_overflow\n      raise StackLevelError, \"Nesting too deep\" if overflow?\n    end\n\n    def overflow?\n      base_scope_depth + @scopes.length > Block::MAX_DEPTH\n    end\n\n    def internal_error\n      # raise and catch to set backtrace and cause on exception\n      raise Liquid::InternalError, 'internal'\n    rescue Liquid::InternalError => exc\n      exc\n    end\n\n    def squash_instance_assigns_with_environments\n      @scopes.last.each_key do |k|\n        @environments.each do |env|\n          if env.key?(k)\n            scopes.last[k] = lookup_and_evaluate(env, k)\n            break\n          end\n        end\n      end\n    end # squash_instance_assigns_with_environments\n  end # Context\nend # Liquid\n","numLines":386,"startLine":1,"totalLines":386}}}
