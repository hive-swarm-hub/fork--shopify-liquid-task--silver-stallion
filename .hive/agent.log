{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DC96gRJUFGuK7DTk9Q7nFr","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\trequire 'cgi'\n4\trequire 'base64'\n5\trequire 'bigdecimal'\n6\tmodule Liquid\n7\t  module StandardFilters\n8\t    MAX_I32 = (1 << 31) - 1\n9\t    private_constant :MAX_I32\n10\t\n11\t    MIN_I64 = -(1 << 63)\n12\t    MAX_I64 = (1 << 63) - 1\n13\t    I64_RANGE = MIN_I64..MAX_I64\n14\t    private_constant :MIN_I64, :MAX_I64, :I64_RANGE\n15\t\n16\t    HTML_ESCAPE = {\n17\t      '&' => '&amp;',\n18\t      '>' => '&gt;',\n19\t      '<' => '&lt;',\n20\t      '\"' => '&quot;',\n21\t      \"'\" => '&#39;',\n22\t    }.freeze\n23\t    HTML_ESCAPE_ONCE_REGEXP = /[\"><']|&(?!([a-zA-Z]+|(#\\d+));)/\n24\t    STRIP_HTML_BLOCKS       = Regexp.union(\n25\t      %r{<script.*?</script>}m,\n26\t      /<!--.*?-->/m,\n27\t      %r{<style.*?</style>}m,\n28\t    )\n29\t    STRIP_HTML_TAGS = /<.*?>/m\n30\t    DATE_FILTER_CACHE = {}\n31\t    DATE_FILTER_CACHE_MAX_FORMATS = 32\n32\t    DATE_FILTER_CACHE_MAX_ENTRIES_PER_FORMAT = 256\n33\t    private_constant :DATE_FILTER_CACHE, :DATE_FILTER_CACHE_MAX_FORMATS, :DATE_FILTER_CACHE_MAX_ENTRIES_PER_FORMAT\n34\t\n35\t    class << self\n36\t      def try_coerce_encoding(input, encoding:)\n37\t        original_encoding = input.encoding\n38\t        if input.encoding != encoding\n39\t          input.force_encoding(encoding)\n40\t          unless input.valid_encoding?\n41\t            input.force_encoding(original_encoding)\n42\t          end\n43\t        end\n44\t        input\n45\t      end\n46\t    end\n47\t\n48\t    # @liquid_public_docs\n49\t    # @liquid_type filter\n50\t    # @liquid_category array\n51\t    # @liquid_summary\n52\t    #   Returns the size of a string or array.\n53\t    # @liquid_description\n54\t    #   The size of a string is the number of characters that the string includes. The size of an array is the number of items\n55\t    #   in the array.\n56\t    # @liquid_syntax variable | size\n57\t    # @liquid_return [number]\n58\t    def size(input)\n59\t      input.respond_to?(:size) ? input.size : 0\n60\t    end\n61\t\n62\t    # @liquid_public_docs\n63\t    # @liquid_type filter\n64\t    # @liquid_category string\n65\t    # @liquid_summary\n66\t    #   Converts a string to all lowercase characters.\n67\t    # @liquid_syntax string | downcase\n68\t    # @liquid_return [string]\n69\t    def downcase(input)\n70\t      Utils.to_s(input).downcase\n71\t    end\n72\t\n73\t    # @liquid_public_docs\n74\t    # @liquid_type filter\n75\t    # @liquid_category string\n76\t    # @liquid_summary\n77\t    #   Converts a string to all uppercase characters.\n78\t    # @liquid_syntax string | upcase\n79\t    # @liquid_return [string]\n80\t    def upcase(input)\n81\t      Utils.to_s(input).upcase\n82\t    end\n83\t\n84\t    # @liquid_public_docs\n85\t    # @liquid_type filter\n86\t    # @liquid_category string\n87\t    # @liquid_summary\n88\t    #   Capitalizes the first word in a string and downcases the remaining characters.\n89\t    # @liquid_syntax string | capitalize\n90\t    # @liquid_return [string]\n91\t    def capitalize(input)\n92\t      Utils.to_s(input).capitalize\n93\t    end\n94\t\n95\t    # @liquid_public_docs\n96\t    # @liquid_type filter\n97\t    # @liquid_category string\n98\t    # @liquid_summary\n99\t    #   Escapes special characters in HTML, such as `<>`, `'`, and `&`, and converts characters into escape sequences. The filter doesn't effect characters within the string that don’t have a corresponding escape sequence.\".\n100\t    # @liquid_syntax string | escape\n101\t    # @liquid_return [string]\n102\t    def escape(input)\n103\t      return if input.nil?\n104\t      CGI.escapeHTML(input.instance_of?(String) ? input : Utils.to_s(input))\n105\t    end\n106\t    alias_method :h, :escape\n107\t\n108\t    # @liquid_public_docs\n109\t    # @liquid_type filter\n110\t    # @liquid_category string\n111\t    # @liquid_summary\n112\t    #   Escapes a string without changing characters that have already been escaped.\n113\t    # @liquid_syntax string | escape_once\n114\t    # @liquid_return [string]\n115\t    def escape_once(input)\n116\t      Utils.to_s(input).gsub(HTML_ESCAPE_ONCE_REGEXP, HTML_ESCAPE)\n117\t    end\n118\t\n119\t    # @liquid_public_docs\n120\t    # @liquid_type filter\n121\t    # @liquid_category string\n122\t    # @liquid_summary\n123\t    #   Converts any URL-unsafe characters in a string to the\n124\t    #   [percent-encoded](https://developer.mozilla.org/en-US/docs/Glossary/percent-encoding) equivalent.\n125\t    # @liquid_description\n126\t    #   > Note:\n127\t    #   > Spaces are converted to a `+` character, instead of a percent-encoded character.\n128\t    # @liquid_syntax string | url_encode\n129\t    # @liquid_return [string]\n130\t    def url_encode(input)\n131\t      CGI.escape(Utils.to_s(input)) unless input.nil?\n132\t    end\n133\t\n134\t    # @liquid_public_docs\n135\t    # @liquid_type filter\n136\t    # @liquid_category string\n137\t    # @liquid_summary\n138\t    #   Decodes any [percent-encoded](https://developer.mozilla.org/en-US/docs/Glossary/percent-encoding) characters\n139\t    #   in a string.\n140\t    # @liquid_syntax string | url_decode\n141\t    # @liquid_return [string]\n142\t    def url_decode(input)\n143\t      return if input.nil?\n144\t\n145\t      result = CGI.unescape(Utils.to_s(input))\n146\t      raise Liquid::ArgumentError, \"invalid byte sequence in #{result.encoding}\" unless result.valid_encoding?\n147\t\n148\t      result\n149\t    end\n150\t\n151\t    # @liquid_public_docs\n152\t    # @liquid_type filter\n153\t    # @liquid_category string\n154\t    # @liquid_summary\n155\t    #   Encodes a string to [Base64 format](https://developer.mozilla.org/en-US/docs/Glossary/Base64).\n156\t    # @liquid_syntax string | base64_encode\n157\t    # @liquid_return [string]\n158\t    def base64_encode(input)\n159\t      Base64.strict_encode64(Utils.to_s(input))\n160\t    end\n161\t\n162\t    # @liquid_public_docs\n163\t    # @liquid_type filter\n164\t    # @liquid_category string\n165\t    # @liquid_summary\n166\t    #   Decodes a string in [Base64 format](https://developer.mozilla.org/en-US/docs/Glossary/Base64).\n167\t    # @liquid_syntax string | base64_decode\n168\t    # @liquid_return [string]\n169\t    def base64_decode(input)\n170\t      input = Utils.to_s(input)\n171\t      StandardFilters.try_coerce_encoding(Base64.strict_decode64(input), encoding: input.encoding)\n172\t    rescue ::ArgumentError\n173\t      raise Liquid::ArgumentError, \"invalid base64 provided to base64_decode\"\n174\t    end\n175\t\n176\t    # @liquid_public_docs\n177\t    # @liquid_type filter\n178\t    # @liquid_category string\n179\t    # @liquid_summary\n180\t    #   Encodes a string to URL-safe [Base64 format](https://developer.mozilla.org/en-US/docs/Glossary/Base64).\n181\t    # @liquid_syntax string | base64_url_safe_encode\n182\t    # @liquid_return [string]\n183\t    def base64_url_safe_encode(input)\n184\t      Base64.urlsafe_encode64(Utils.to_s(input))\n185\t    end\n186\t\n187\t    # @liquid_public_docs\n188\t    # @liquid_type filter\n189\t    # @liquid_category string\n190\t    # @liquid_summary\n191\t    #   Decodes a string in URL-safe [Base64 format](https://developer.mozilla.org/en-US/docs/Glossary/Base64).\n192\t    # @liquid_syntax string | base64_url_safe_decode\n193\t    # @liquid_return [string]\n194\t    def base64_url_safe_decode(input)\n195\t      input = Utils.to_s(input)\n196\t      StandardFilters.try_coerce_encoding(Base64.urlsafe_decode64(input), encoding: input.encoding)\n197\t    rescue ::ArgumentError\n198\t      raise Liquid::ArgumentError, \"invalid base64 provided to base64_url_safe_decode\"\n199\t    end\n200\t\n201\t    # @liquid_public_docs\n202\t    # @liquid_type filter\n203\t    # @liquid_category string\n204\t    # @liquid_summary\n205\t    #   Returns a substring or series of array items, starting at a given 0-based index.\n206\t    # @liquid_description\n207\t    #   By default, the substring has a length of one character, and the array series has one array item. However, you can\n208\t    #   provide a second parameter to specify the number of characters or array items.\n209\t    # @liquid_syntax string | slice\n210\t    # @liquid_return [string]\n211\t    def slice(input, offset, length = nil)\n212\t      offset = Utils.to_integer(offset)\n213\t      length = length ? Utils.to_integer(length) : 1\n214\t\n215\t      begin\n216\t        if input.is_a?(Array)\n217\t          input.slice(offset, length) || []\n218\t        else\n219\t          Utils.to_s(input).slice(offset, length) || ''\n220\t        end\n221\t      rescue RangeError\n222\t        if I64_RANGE.cover?(length) && I64_RANGE.cover?(offset)\n223\t          raise # unexpected error\n224\t        end\n225\t        offset = offset.clamp(I64_RANGE)\n226\t        length = length.clamp(I64_RANGE)\n227\t        retry\n228\t      end\n229\t    end\n230\t\n231\t    # @liquid_public_docs\n232\t    # @liquid_type filter\n233\t    # @liquid_category string\n234\t    # @liquid_summary\n235\t    #   Truncates a string down to a given number of characters.\n236\t    # @liquid_description\n237\t    #   If the specified number of characters is less than the length of the string, then an ellipsis (`...`) is appended to\n238\t    #   the truncated string. The ellipsis is included in the character count of the truncated string.\n239\t    # @liquid_syntax string | truncate: number\n240\t    # @liquid_return [string]\n241\t    def truncate(input, length = 50, truncate_string = \"...\")\n242\t      return if input.nil?\n243\t      input_str = Utils.to_s(input)\n244\t      length    = Utils.to_integer(length)\n245\t\n246\t      truncate_string_str = Utils.to_s(truncate_string)\n247\t\n248\t      l = length - truncate_string_str.length\n249\t      l = 0 if l < 0\n250\t\n251\t      if input_str.length > length\n252\t        result = +input_str.slice(0, l)\n253\t        result << truncate_string_str\n254\t      else\n255\t        input_str\n256\t      end\n257\t    end\n258\t\n259\t    # @liquid_public_docs\n260\t    # @liquid_type filter\n261\t    # @liquid_category string\n262\t    # @liquid_summary\n263\t    #   Truncates a string down to a given number of words.\n264\t    # @liquid_description\n265\t    #   If the specified number of words is less than the number of words in the string, then an ellipsis (`...`) is appended to\n266\t    #   the truncated string.\n267\t    #\n268\t    #   > Caution:\n269\t    #   > HTML tags are treated as words, so you should strip any HTML from truncated content. If you don't strip HTML, then\n270\t    #   > closing HTML tags can be removed, which can result in unexpected behavior.\n271\t    # @liquid_syntax string | truncatewords: number\n272\t    # @liquid_return [string]\n273\t    def truncatewords(input, words = 15, truncate_string = \"...\")\n274\t      return if input.nil?\n275\t      input = Utils.to_s(input)\n276\t      words = Utils.to_integer(words)\n277\t      words = 1 if words <= 0\n278\t\n279\t      return input if words + 1 > MAX_I32\n280\t\n281\t      len = input.bytesize\n282\t      pos = 0\n283\t      word_count = 0\n284\t\n285\t      # Skip leading whitespace\n286\t      while pos < len\n287\t        b = input.getbyte(pos)\n288\t        break unless b == 32 || b == 9 || b == 10 || b == 13 || b == 12\n289\t        pos += 1\n290\t      end\n291\t\n292\t      first_word_start = pos\n293\t      last_word_end = pos\n294\t      simple_spacing = true\n295\t\n296\t      while pos < len\n297\t        word_count += 1\n298\t        word_start = pos\n299\t\n300\t        # Skip non-whitespace chars (word body)"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"9cd01888-1ff4-4d02-a154-9a4648541fde","timestamp":"2026-04-03T16:53:47.905Z"}
