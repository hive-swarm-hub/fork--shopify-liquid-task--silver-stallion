{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K5XuQfmQ6Z2UpGrRVHspTH","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # @liquid_public_docs\n5\t  # @liquid_type tag\n6\t  # @liquid_category conditional\n7\t  # @liquid_name if\n8\t  # @liquid_summary\n9\t  #   Renders an expression if a specific condition is `true`.\n10\t  # @liquid_syntax\n11\t  #   {% if condition %}\n12\t  #     expression\n13\t  #   {% endif %}\n14\t  # @liquid_syntax_keyword condition The condition to evaluate.\n15\t  # @liquid_syntax_keyword expression The expression to render if the condition is met.\n16\t  class If < Block\n17\t    Syntax                  = /(#{QuotedFragment})\\s*([=!<>a-z_]+)?\\s*(#{QuotedFragment})?/o\n18\t    ExpressionsAndOperators = /(?:\\b(?:\\s?and\\s?|\\s?or\\s?)\\b|(?:\\s*(?!\\b(?:\\s?and\\s?|\\s?or\\s?)\\b)(?:#{QuotedFragment}|\\S+)\\s*)+)/o\n19\t    BOOLEAN_OPERATORS       = %w(and or).freeze\n20\t\n21\t    attr_reader :blocks\n22\t\n23\t    def initialize(tag_name, markup, options)\n24\t      super\n25\t      @blocks = []\n26\t      push_block('if', markup)\n27\t    end\n28\t\n29\t    def nodelist\n30\t      @blocks.map(&:attachment)\n31\t    end\n32\t\n33\t    def parse(tokens)\n34\t      while parse_body(@blocks.last.attachment, tokens)\n35\t      end\n36\t      @blocks.reverse_each do |block|\n37\t        block.attachment.remove_blank_strings if blank?\n38\t        block.attachment.freeze\n39\t      end\n40\t    end\n41\t\n42\t    ELSE_TAG_NAMES = ['elsif', 'else'].freeze\n43\t    private_constant :ELSE_TAG_NAMES\n44\t\n45\t    def unknown_tag(tag, markup, tokens)\n46\t      if ELSE_TAG_NAMES.include?(tag)\n47\t        push_block(tag, markup)\n48\t      else\n49\t        super\n50\t      end\n51\t    end\n52\t\n53\t    def render_to_output_buffer(context, output)\n54\t      idx = 0\n55\t      blocks = @blocks\n56\t      len = blocks.length\n57\t      while idx < len\n58\t        block = blocks[idx]\n59\t        result = Liquid::Utils.to_liquid_value(block.evaluate(context))\n60\t\n61\t        if result\n62\t          return block.attachment.render_to_output_buffer(context, output)\n63\t        end\n64\t        idx += 1\n65\t      end\n66\t\n67\t      output\n68\t    end\n69\t\n70\t    private\n71\t\n72\t    def strict2_parse(markup)\n73\t      strict_parse(markup)\n74\t    end\n75\t\n76\t    def push_block(tag, markup)\n77\t      block = if tag == 'else'\n78\t        ElseCondition.new\n79\t      else\n80\t        parse_with_selected_parser(markup)\n81\t      end\n82\t\n83\t      @blocks.push(block)\n84\t      block.attach(new_body)\n85\t    end\n86\t\n87\t    def parse_expression(markup, safe: false)\n88\t      Condition.parse_expression(parse_context, markup, safe: safe)\n89\t    end\n90\t\n91\t    def lax_parse(markup)\n92\t      # Fastest path: simple identifier truthiness like \"product.available\" or \"forloop.first\"\n93\t      if (simple = Variable.simple_variable_markup(markup))\n94\t        return Condition.new(parse_expression(simple))\n95\t      end\n96\t\n97\t      # Fast path: simple condition without and/or — use Cursor\n98\t      if !markup.include?(' and ') && !markup.include?(' or ')\n99\t        cursor = @parse_context.cursor\n100\t        cursor.reset(markup)\n101\t        if cursor.parse_simple_condition\n102\t          return Condition.new(\n103\t            parse_expression(cursor.cond_left),\n104\t            cursor.cond_op,\n105\t            cursor.cond_right ? parse_expression(cursor.cond_right) : nil,\n106\t          )\n107\t        end\n108\t      end\n109\t\n110\t      expressions = markup.scan(ExpressionsAndOperators)\n111\t      raise SyntaxError, options[:locale].t(\"errors.syntax.if\") unless expressions.pop =~ Syntax\n112\t\n113\t      condition = Condition.new(parse_expression(Regexp.last_match(1)), Regexp.last_match(2), parse_expression(Regexp.last_match(3)))\n114\t\n115\t      until expressions.empty?\n116\t        operator = expressions.pop.to_s.strip\n117\t\n118\t        raise SyntaxError, options[:locale].t(\"errors.syntax.if\") unless expressions.pop.to_s =~ Syntax\n119\t\n120\t        new_condition = Condition.new(parse_expression(Regexp.last_match(1)), Regexp.last_match(2), parse_expression(Regexp.last_match(3)))\n121\t        raise SyntaxError, options[:locale].t(\"errors.syntax.if\") unless BOOLEAN_OPERATORS.include?(operator)\n122\t        new_condition.send(operator, condition)\n123\t        condition = new_condition\n124\t      end\n125\t\n126\t      condition\n127\t    end\n128\t\n129\t    def strict_parse(markup)\n130\t      p = @parse_context.new_parser(markup)\n131\t      condition = parse_binary_comparisons(p)\n132\t      p.consume(:end_of_string)\n133\t      condition\n134\t    end\n135\t\n136\t    def parse_binary_comparisons(p)\n137\t      condition = parse_comparison(p)\n138\t      first_condition = condition\n139\t      while (op = p.id?('and') || p.id?('or'))\n140\t        child_condition = parse_comparison(p)\n141\t        condition.send(op, child_condition)\n142\t        condition = child_condition\n143\t      end\n144\t      first_condition\n145\t    end\n146\t\n147\t    def parse_comparison(p)\n148\t      a = parse_expression(p.expression, safe: true)\n149\t      if (op = p.consume?(:comparison))\n150\t        b = parse_expression(p.expression, safe: true)\n151\t        Condition.new(a, op, b)\n152\t      else\n153\t        Condition.new(a)\n154\t      end\n155\t    end\n156\t\n157\t    class ParseTreeVisitor < Liquid::ParseTreeVisitor\n158\t      def children\n159\t        @node.blocks\n160\t      end\n161\t    end\n162\t  end\n163\tend\n164\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"70ca7111-90b0-4eb2-9c10-58584a461c0e","timestamp":"2026-04-03T16:53:45.474Z"}
