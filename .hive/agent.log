okup.instance_of?(String) ? lookup : context.evaluate(lookup)\n208\t\n209\t        # Cast \"key\" to its liquid value to enable it to act as a primitive value\n210\t        # Fast path: strings and integers (most common key types) don't need conversion\n211\t        unless key.instance_of?(String) || key.instance_of?(Integer)\n212\t          key = Liquid::Utils.to_liquid_value(key)\n213\t        end\n214\t\n215\t        # If object is a hash- or array-like object we look for the\n216\t        # presence of the key and if its available we return it\n217\t        if object.instance_of?(Hash) ? object.key?(key) :\n218\t            (object.respond_to?(:[]) &&\n219\t              ((object.respond_to?(:key?) && object.key?(key)) ||\n220\t               (object.respond_to?(:fetch) && key.is_a?(Integer))))\n221\t\n222\t          # if its a proc we will replace the entry with the proc\n223\t          object = context.lookup_and_evaluate(object, key)\n224\t          # Skip to_liquid for common primitive types (they return self)\n225\t          unless object.instance_of?(String) || object.instance_of?(Integer) || object.instance_of?(Float) ||\n226\t              object.instance_of?(Array) || object.instance_of?(Hash) || object.nil?\n227\t            object = object.to_liquid\n228\t            object.context = context if object.respond_to?(:context=)\n229\t          end\n230\t\n231\t          # Some special cases. If the part wasn't in square brackets and\n232\t          # no key with the same name was found we interpret following calls\n233\t          # as commands and call them on the current object\n234\t        elsif lookup_command?(i) && object.respond_to?(key)\n235\t          object = object.send(key)\n236\t          unless object.instance_of?(String) || object.instance_of?(Integer) || object.instance_of?(Array) || object.nil?\n237\t            object = object.to_liquid\n238\t            object.context = context if object.respond_to?(:context=)\n239\t          end\n240\t\n241\t        # Handle string first/last like ActiveSupport does (returns first/last character)\n242\t        # ActiveSupport returns \"\" for empty strings, not nil\n243\t        elsif lookup_command?(i) && object.is_a?(String) && (key == \"first\" || key == \"last\")\n244\t          object = key == \"first\" ? (object[0] || \"\") : (object[-1] || \"\")\n245\t\n246\t          # No key was present with the desired value and it wasn't one of the directly supported\n247\t          # keywords either. The only thing we got left is to return nil or\n248\t          # raise an exception if `strict_variables` option is set to true\n249\t        else\n250\t          return nil unless context.strict_variables\n251\t          raise Liquid::UndefinedVariable, \"undefined variable #{key}\"\n252\t        end\n253\t        i += 1\n254\t      end\n255\t\n256\t      object\n257\t    end\n258\t\n259\t    def ==(other)\n260\t      self.class == other.class && state == other.state\n261\t    end\n262\t\n263\t    protected\n264\t\n265\t    def state\n266\t      [@name, @lookups, @command_flags]\n267\t    end\n268\t\n269\t    class ParseTreeVisitor < Liquid::ParseTreeVisitor\n270\t      def children\n271\t        @node.lookups\n272\t      end\n273\t    end\n274\t  end\n275\tend\n276\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"e34def16-3f86-47c2-8a6b-b19f1a35af05","timestamp":"2026-04-03T16:53:43.880Z"}
