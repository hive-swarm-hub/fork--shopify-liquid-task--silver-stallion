pos < len\n59\t        b = markup.getbyte(pos)\n60\t        return unless b == 32 || b == 9 || b == 10 || b == 13\n61\t        pos += 1\n62\t      end\n63\t\n64\t      # Must have consumed everything\n65\t      return unless pos == len\n66\t\n67\t      if start == 0 && content_end == len\n68\t        markup\n69\t      else\n70\t        markup.byteslice(start, content_end - start)\n71\t      end\n72\t    end\n73\t\n74\t    FILTER_NAME_INTERN = Hash.new { |h, k| h[k] = k.freeze }\n75\t\n76\t    # Integer-key lookup for common filter names (avoids byteslice allocation)\n77\t    FILTER_INT_KEYS = {}\n78\t    %w[escape money json size first last default date strip_html\n79\t       truncatewords upcase downcase capitalize strip lstrip rstrip\n80\t       replace split join sort reverse map compact uniq\n81\t       abs ceil floor round plus minus times divided_by modulo\n82\t       append prepend remove remove_first replace_first slice\n83\t       truncate url_encode url_decode newline_to_br strip_newlines\n84\t       img_tag script_tag stylesheet_tag link_to].each do |name|\n85\t      next if name.bytesize > 7\n86\t      key = 0\n87\t      name.each_byte { |b| key = (key << 8) | b }\n88\t      FILTER_INT_KEYS[key] = name.freeze\n89\t    end\n90\t    FILTER_INT_KEYS.freeze\n91\t\n92\t    # Cache for [filtername, EMPTY_ARRAY] tuples — avoids repeated array creation\n93\t    NO_ARG_FILTER_CACHE = Hash.new { |h, k| h[k] = [k, Const::EMPTY_ARRAY].freeze }\n94\t\n95\t    SINGLE_NO_ARG_FILTER_CACHE = Hash.new { |h, k| h[k] = [NO_ARG_FILTER_CACHE[k]].freeze }\n96\t\n97\t    # Global cache for variable parse state (markup → [name, filters]).\n98\t    GLOBAL_VARIABLE_STATE_CACHE = {}\n99\t\n100\t    FilterMarkupRegex        = /#{FilterSeparator}\\s*(.*)/om\n101\t    FilterParser             = /(?:\\s+|#{QuotedFragment}|#{ArgumentSeparator})+/o\n102\t    FilterArgsRegex          = /(?:#{FilterArgumentSeparator}|#{ArgumentSeparator})\\s*((?:\\w+\\s*\\:\\s*)?#{QuotedFragment})/o\n103\t