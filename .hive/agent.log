{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014PJdDVE8AJRQ4XJ2vSfZok","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  module Utils\n5\t    DECIMAL_REGEX = /\\A-?\\d+\\.\\d+\\z/\n6\t    UNIX_TIMESTAMP_REGEX = /\\A\\d+\\z/\n7\t\n8\t    def self.slice_collection(collection, from, to)\n9\t      if (from != 0 || !to.nil?) && collection.respond_to?(:load_slice)\n10\t        collection.load_slice(from, to)\n11\t      elsif collection.is_a?(Array)\n12\t        if from == 0 && to.nil?\n13\t          collection\n14\t        elsif to\n15\t          collection.slice(from, to - from) || Const::EMPTY_ARRAY\n16\t        else\n17\t          collection.slice(from..) || Const::EMPTY_ARRAY\n18\t        end\n19\t      else\n20\t        slice_collection_using_each(collection, from, to)\n21\t      end\n22\t    end\n23\t\n24\t    def self.slice_collection_using_each(collection, from, to)\n25\t      segments = []\n26\t      index    = 0\n27\t\n28\t      # Maintains Ruby 1.8.7 String#each behaviour on 1.9\n29\t      if collection.is_a?(String)\n30\t        return collection.empty? ? [] : [collection]\n31\t      end\n32\t      return [] unless collection.respond_to?(:each)\n33\t\n34\t      collection.each do |item|\n35\t        if to && to <= index\n36\t          break\n37\t        end\n38\t\n39\t        if from <= index\n40\t          segments << item\n41\t        end\n42\t\n43\t        index += 1\n44\t      end\n45\t\n46\t      segments\n47\t    end\n48\t\n49\t    def self.to_integer(num)\n50\t      return num if num.is_a?(Integer)\n51\t      num = num.to_s\n52\t      begin\n53\t        Integer(num)\n54\t      rescue ::ArgumentError\n55\t        raise Liquid::ArgumentError, \"invalid integer\"\n56\t      end\n57\t    end\n58\t\n59\t    def self.to_number(obj)\n60\t      case obj\n61\t      when Float\n62\t        BigDecimal(obj.to_s)\n63\t      when Numeric\n64\t        obj\n65\t      when String\n66\t        DECIMAL_REGEX.match?(obj.strip) ? BigDecimal(obj) : obj.to_i\n67\t      else\n68\t        if obj.respond_to?(:to_number)\n69\t          obj.to_number\n70\t        else\n71\t          0\n72\t        end\n73\t      end\n74\t    end\n75\t\n76\t    def self.to_date(obj)\n77\t      return obj if obj.respond_to?(:strftime)\n78\t\n79\t      if obj.is_a?(String)\n80\t        return if obj.empty?\n81\t        obj = obj.downcase\n82\t      end\n83\t\n84\t      case obj\n85\t      when 'now', 'today'\n86\t        Time.now\n87\t      when UNIX_TIMESTAMP_REGEX, Integer\n88\t        Time.at(obj.to_i)\n89\t      when String\n90\t        Time.parse(obj)\n91\t      end\n92\t    rescue ::ArgumentError\n93\t      nil\n94\t    end\n95\t\n96\t    def self.to_liquid_value(obj)\n97\t      # Fast path: primitive types never have to_liquid_value\n98\t      case obj\n99\t      when String, Integer, Float, NilClass, TrueClass, FalseClass, Array, Hash\n100\t        return obj\n101\t      end\n102\t      # Enable \"obj\" to represent itself as a primitive value like integer, string, or boolean\n103\t      return obj.to_liquid_value if obj.respond_to?(:to_liquid_value)\n104\t\n105\t      # Otherwise return the object itself\n106\t      obj\n107\t    end\n108\t\n109\t    # Cached string representations for common small integers (0-999)\n110\t    # Avoids repeated Integer#to_s allocations during rendering\n111\t    SMALL_INT_STRINGS = Array.new(1000) { |i| i.to_s.freeze }.freeze\n112\t\n113\t    def self.to_s(obj, seen = nil)\n114\t      case obj\n115\t      when Integer\n116\t        return (obj >= 0 && obj < 1000) ? SMALL_INT_STRINGS[obj] : obj.to_s\n117\t      when BigDecimal\n118\t        obj.to_s(\"F\")\n119\t      when Hash\n120\t        # If the custom hash implementation overrides `#to_s`, use their\n121\t        # custom implementation. Otherwise we use Liquid's default\n122\t        # implementation.\n123\t        if obj.class.instance_method(:to_s) == HASH_TO_S_METHOD\n124\t          hash_ins