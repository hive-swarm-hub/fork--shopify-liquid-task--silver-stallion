iquid_syntax variable | size\n57\t    # @liquid_return [number]\n58\t    def size(input)\n59\t      input.respond_to?(:size) ? input.size : 0\n60\t    end\n61\t\n62\t    # @liquid_public_docs\n63\t    # @liquid_type filter\n64\t    # @liquid_category string\n65\t    # @liquid_summary\n66\t    #   Converts a string to all lowercase characters.\n67\t    # @liquid_syntax string | downcase\n68\t    # @liquid_return [string]\n69\t    def downcase(input)\n70\t      Utils.to_s(input).downcase\n71\t    end\n72\t\n73\t    # @liquid_public_docs\n74\t    # @liquid_type filter\n75\t    # @liquid_category string\n76\t    # @liquid_summary\n77\t    #   Converts a string to all uppercase characters.\n78\t    # @liquid_syntax string | upcase\n79\t    # @liquid_return [string]\n80\t    def upcase(input)\n81\t      Utils.to_s(input).upcase\n82\t    end\n83\t\n84\t    # @liquid_public_docs\n85\t    # @liquid_type filter\n86\t    # @liquid_category string\n87\t    # @liquid_summary\n88\t    #   Capitalizes the first word in a string and downcases the remaining characters.\n89\t    # @liquid_syntax string | capitalize\n90\t    # @liquid_return [string]\n91\t    def capitalize(input)\n92\t      Utils.to_s(input).capitalize\n93\t    end\n94\t\n95\t    # @liquid_public_docs\n96\t    # @liquid_type filter\n97\t    # @liquid_category string\n98\t    # @liquid_summary\n99\t    #   Escapes special characters in HTML, such as `<>`, `'`, and `&`, and converts characters into escape sequences. The filter doesn't effect characters within the string that don’t have a corresponding escape sequence.\".\n100\t    # @liquid_syntax string | escape\n101\t    # @liquid_return [string]\n102\t    def escape(input)\n103\t      CGI.escapeHTML(Utils.to_s(input)) unless input.nil?\n104\t    end\n105\t    alias_method :h, :escape"}]},"parent_tool_use_id":null,"session_id":"77214d7b-bd04-44d4-b63f-1333e1a922ed","uuid":"e5fcc3b8-c08e-45a5-a5da-a573daf2d80e","timestamp":"2026-04-03T08:14:56.287Z","tool_use_result":