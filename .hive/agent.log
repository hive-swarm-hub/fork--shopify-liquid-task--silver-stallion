{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017eR5cLzUkfbmuYGU2Hc6pY","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # Container for liquid nodes which conveniently wraps decision making logic\n5\t  #\n6\t  # Example:\n7\t  #\n8\t  #   c = Condition.new(1, '==', 1)\n9\t  #   c.evaluate #=> true\n10\t  #\n11\t  class Condition # :nodoc:\n12\t    @@operators = {\n13\t      '==' => ->(cond, left, right) {  cond.send(:equal_variables, left, right) },\n14\t      '!=' => ->(cond, left, right) { !cond.send(:equal_variables, left, right) },\n15\t      '<>' => ->(cond, left, right) { !cond.send(:equal_variables, left, right) },\n16\t      '<' => :<,\n17\t      '>' => :>,\n18\t      '>=' => :>=,\n19\t      '<=' => :<=,\n20\t      'contains' => lambda do |_cond, left, right|\n21\t        if left && right && left.respond_to?(:include?)\n22\t          right = right.to_s if left.is_a?(String)\n23\t          left.include?(right)\n24\t        else\n25\t          false\n26\t        end\n27\t      rescue Encoding::CompatibilityError\n28\t        # \"✅\".b.include?(\"✅\") raises Encoding::CompatibilityError despite being materially equal\n29\t        left.b.include?(right.b)\n30\t      end,\n31\t    }\n32\t\n33\t    class MethodLiteral\n34\t      attr_reader :method_name, :to_s\n35\t\n36\t      def initialize(method_name, to_s)\n37\t        @method_name = method_name\n38\t        @to_s = to_s\n39\t      end\n40\t    end\n41\t\n42\t    @@method_literals = {\n43\t      'blank' => MethodLiteral.new(:blank?, '').freeze,\n44\t      'empty' => MethodLiteral.new(:empty?, '').freeze,\n45\t    }\n46\t\n47\t    def self.operators\n48\t      @@operators\n49\t    end\n50\t\n51\t    def self.parse_expression(parse_context, markup, safe: false)\n52\t      @@method_literals[markup] || parse_context.parse_expression(markup, safe: safe)\n53\t    end\n54\t\n55\t    attr_reader :attachment, :child_condition\n56\t    attr_accessor :left, :operator, :right\n57\t\n58\t    def initialize(left = nil, operator = nil, right = nil)\n59\t      @left     = left\n60\t      @operator = operator\n61\t      @right    = right\n62\t\n63\t      @child_relation  = nil\n64\t      @child_condition = nil\n65\t    end\n66\t\n67\t    def evaluate(context = deprecated_default_context)\n68\t      result = interpret_condition(@left, @right, @operator, context)\n69\t\n70\t      # Fast path: no child conditions (most common)\n71\t      return result unless @child_relation\n72\t\n73\t      condition = self\n74\t      loop do\n75\t        case condition.child_relation\n76\t        when :or\n77\t          r = result.respond_to?(:to_liquid_value) ? result.to_liquid_value : result\n78\t          break if r\n79\t        when :and\n80\t          r = result.respond_to?(:to_liquid_value) ? result.to_liquid_value : result\n81\t          break unless r\n82\t        else\n83\t          break\n84\t        end\n85\t        condition = condition.child_condition\n86\t        result = interpret_condition(condition.left, condition.right, condition.operator, context)\n87\t      end\n88\t      result\n89\t    end\n90\t\n91\t    def or(condition)\n92\t      @child_relation  = :or\n93\t      @child_condition = condition\n94\t    end\n95\t\n96\t    def and(condition)\n97\t      @child_relation  = :and\n98\t      @child_condition = condition\n99\t    end\n100\t\n101\t    def attach(attachment)\n102\t      @attachment = attachment\n103\t    end\n104\t\n105\t    def else?\n106\t      false\n107\t    end\n108\t\n109\t    def inspect\n110\t      \"#<Condition #{[@left, @operator, @right].compact.join(' ')}>\"\n111\t    end\n112\t\n113\t    protected\n114\t\n115\t    attr_reader :child_relation\n116\t\n117\t    private\n118\t\n119\t    def equal_variables(left, right)\n120\t      if left.is_a?(MethodLiteral)\n121\t        return call_method_literal(left, right)\n122\t      end\n123\t\n124\t      if right.is_a?(MethodLiteral)\n125\t        return call_method_literal(right, left)\n126\t      end\n127\t\n128\t      left == right\n129\t    end\n130\t\n131\t    def call_method_literal(literal, value)\n132\t      method_name = literal.method_name\n133\t\n134\t      # If the object responds to the method (e.g., ActiveSupport is loaded), use it\n135\t      if value.respond_to?(method_name)\n136\t        value.send(method_name)\n137\t      else\n138\t        # Emulate ActiveSupport's blank?/empty? to make Liquid invariant\n139\t        # to whether ActiveSupport is loaded or not\n140\t        case method_name\n141\t        when :blank?\n142\t          liquid_blank?(value)\n143\t        when :empty?\n144\t          liquid_empty?(value)\n145\t        else\n146\t          false\n147\t        end\n148\t      end\n149\t    end\n150\t\n151\t    # Implement blank? semantics matching ActiveSupport\n152\t    # blank? returns true for nil, false, empty strings, whitespace-only strings,\n153\t    # empty arrays, and empty hashes\n154\t    def liquid_blank?(value)\n155\t      case value\n156\t      when NilClass, FalseClass\n157\t        true\n158\t      when TrueClass, Numeric\n159\t        false\n160\t      when String\n161\t        # Blank if empty or whitespace only (matches ActiveSupport)\n162\t        value.empty? || value.match?(/\\A\\s*\\z/)\n163\t      when Array, Hash\n164\t        value.empty?\n165\t      else\n166\t        # Fall back to empty? if available, otherwise false\n167\t        value.respond_to?(:empty?) ? value.empty? : false\n168\t      end\n169\t    end\n170\t\n171\t    # Implement empty? semantics\n172\t    # Note: nil is NOT empty. empty? checks if a collection has zero elements.\n173\t    def liquid_empty?(value)\n174\t      case value\n175\t      when String, Array, Hash\n176\t        value.empty?\n177\t      else\n178\t        value.respond_to?(:empty?) ? value.empty? : false\n179\t      end\n180\t    end\n181\t\n182\t    def interpret_condition(left, right, op, context)\n183\t      # If the operator is empty this means that the decision statement is just\n184\t      # a single variable. We can just poll this variable from the context and\n185\t      # return this as the result.\n186\t      return context.evaluate(left) if op.nil?\n187\t\n188\t      left  = Liquid::Utils.to_liquid_value(context.evaluate(left))\n189\t      right = Liquid::Utils.to_liquid_value(context.evaluate(right))\n190\t\n191\t      case op\n192\t      when '=='\n193\t        equal_variables(left, right)\n194\t      when '!='\n195\t        !equal_variables(left, right)\n196\t      when '<', '>', '>=', '<='\n197\t        if left.respond_to?(op) && right.respond_to?(op) && !left.is_a?(Hash) && !right.is_a?(Hash)\n198\t          left.send(op, right)\n199\t        end\n200\t      else\n201\t        operation = self.class.operators[op] || raise(Liquid::ArgumentError, \"Unknown operator #{op}\")\n202\t        if operation.respond_to?(:call)\n203\t          operation.call(self, left, right)\n204\t        elsif left.respond_to?(operation) && right.respond_to?(operation) && !left.is_a?(Hash) && !right.is_a?(Hash)\n205\t          begin\n206\t            left.send(operation, right)\n207\t          rescue ::ArgumentError => e\n208\t            raise Liquid::ArgumentError, e.message\n209\t          end\n210\t        end\n211\t      end\n212\t    rescue ::ArgumentError => e\n213\t      raise Liquid::ArgumentError, e.message\n214\t    end\n215\t\n216\t    def deprecated_default_context\n217\t      warn(\"DEPRECATION WARNING: Condition#evaluate without a context argument is deprecated \" \\\n218\t        \"and will be removed from Liquid 6.0.0.\")\n219\t      Context.new\n220\t    end\n221\t\n222\t    class ParseTreeVisitor < Liquid::ParseTreeVisitor\n223\t      def children\n224\t        [\n225\t          @node.left,\n226\t          @node.right,\n227\t          @node.child_condition,\n228\t          @node.attachment\n229\t        ].compact\n230\t      end\n231\t    end\n232\t  end\n233\t\n234\t  class ElseCondition < Condition\n235\t    def else?\n236\t      true\n237\t    end\n238\t\n239\t    def evaluate(_context)\n240\t      true\n241\t    end\n242\t  end\n243\tend\n244\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"0d18eff8-6381-4cb8-be67-158bde4da433","timestamp":"2026-04-03T16:53:45.147Z"}
