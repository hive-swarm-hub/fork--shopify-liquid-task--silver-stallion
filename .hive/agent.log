{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E7tTigNjB82p37mp2pPHb3","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # @liquid_public_docs\n5\t  # @liquid_type tag\n6\t  # @liquid_category iteration\n7\t  # @liquid_name for\n8\t  # @liquid_summary\n9\t  #   Renders an expression for every item in an array.\n10\t  # @liquid_description\n11\t  #   You can do a maximum of 50 iterations with a `for` loop. If you need to iterate over more than 50 items, then use the\n12\t  #   [`paginate` tag](/docs/api/liquid/tags/paginate) to split the items over multiple pages.\n13\t  #\n14\t  #   > Tip:\n15\t  #   > Every `for` loop has an associated [`forloop` object](/docs/api/liquid/objects/forloop) with information about the loop.\n16\t  # @liquid_syntax\n17\t  #   {% for variable in array %}\n18\t  #     expression\n19\t  #   {% endfor %}\n20\t  # @liquid_syntax_keyword variable The current item in the array.\n21\t  # @liquid_syntax_keyword array The array to iterate over.\n22\t  # @liquid_syntax_keyword expression The expression to render for each iteration.\n23\t  # @liquid_optional_param limit: [number] The number of iterations to perform.\n24\t  # @liquid_optional_param offset: [number] The 1-based index to start iterating at.\n25\t  # @liquid_optional_param range [untyped] A custom numeric range to iterate over.\n26\t  # @liquid_optional_param reversed [untyped] Iterate in reverse order.\n27\t  class For < Block\n28\t    Syntax = /\\A(#{VariableSegment}+)\\s+in\\s+(#{QuotedFragment}+)\\s*(reversed)?/o\n29\t\n30\t    attr_reader :collection_name, :variable_name, :limit, :from\n31\t\n32\t    def initialize(tag_name, markup, options)\n33\t      super\n34\t      @from = @limit = nil\n35\t      parse_with_selected_parser(markup)\n36\t      @for_block = new_body\n37\t      @else_block = nil\n38\t    end\n39\t\n40\t    def parse(tokens)\n41\t      if parse_body(@for_block, tokens)\n42\t        parse_body(@else_block, tokens)\n43\t      end\n44\t      if blank?\n45\t        @else_block&.remove_blank_strings\n46\t        @for_block.remove_blank_strings\n47\t      end\n48\t      @else_block&.freeze\n49\t      @for_block.freeze\n50\t    end\n51\t\n52\t    def nodelist\n53\t      @else_block ? [@for_block, @else_block] : [@for_block]\n54\t    end\n55\t\n56\t    def unknown_tag(tag, markup, tokens)\n57\t      return super unless tag == 'else'\n58\t      @else_block = new_body\n59\t    end\n60\t\n61\t    def render_to_output_buffer(context, output)\n62\t      segment = collection_segment(context)\n63\t\n64\t      if segment.empty?\n65\t        render_else(context, output)\n66\t      else\n67\t        render_segment(context, output, segment)\n68\t      end\n69\t\n70\t      output\n71\t    end\n72\t\n73\t    protected\n74\t\n75\t    # Fast byte-level parser for \"var in collection [reversed] [limit:N] [offset:N]\"\n76\t    REVERSED_BYTES = \"reversed\".bytes.freeze\n77\t\n78\t    def lax_parse(markup)\n79\t      c = @parse_context.cursor\n80\t      c.reset(markup)\n81\t      c.skip_ws\n82\t\n83\t      # Parse variable name\n84\t      var_start = c.pos\n85\t      var_len = c.skip_id\n86\t      raise SyntaxError, options[:locale].t(\"errors.syntax.for\") if var_len == 0\n87\t      @variable_name = c.slice(var_start, var_len)\n88\t\n89\t      # Expect \"in\"\n90\t      c.skip_ws\n91\t      raise SyntaxError, options[:locale].t(\"errors.syntax.for\") unless c.expect_id(\"in\")\n92\t      c.skip_ws\n93\t\n94\t      # Parse collection name\n95\t      col_start = c.pos\n96\t      if c.peek_byte == Cursor::LPAREN\n97\t        # Parenthesized range: (1..10)\n98\t        depth = 1\n99\t        c.scan_byte\n100\t        while !c.eos? && depth > 0\n101\t          b = c.scan_byte\n102\t          depth += 1 if b == Cursor::LPAREN\n103\t          depth -= 1 if b == Cursor::RPAREN\n104\t        end\n105\t      else\n106\t        c.skip_fragment\n107\t      end\n108\t      collection_name = c.slice(col_start, c.pos - col_start)\n109\t\n110\t      @name            = \"#{@variable_name}-#{collection_name}\"\n111\t      @collection_name = parse_expression(collection_name)\n112\t\n113\t      c.skip_ws\n114\t      @reversed = c.expect_id(\"reversed\")\n115\t      c.skip_ws\n116\t\n117\t      # Parse limit:/offset: if present\n118\t      while !c.eos?\n119\t        c.skip_ws\n120\t        break if c.eos?\n121\t        if c.peek_byte == Cursor::COMMA\n122\t          c.scan_byte\n123\t          c.skip_ws\n124\t        end\n125\t        key = c.scan_id\n126\t        break unless key\n127\t        c.skip_ws\n128\t        break unless c.peek_byte == Cursor::COLON\n129\t        c.scan_byte\n130\t        c.skip_ws\n131\t        value = c.scan_fragment\n132\t        break unless value\n133\t        set_attribute(key, value)\n134\t      end\n135\t    end\n136\t\n137\t    def strict_parse(markup)\n138\t      p = @parse_context.new_parser(markup)\n139\t      @variable_name = p.consume(:id)\n140\t      raise SyntaxError, options[:locale].t(\"errors.syntax.for_invalid_in\") unless p.id?('in')\n141\t\n142\t      collection_name  = p.expression\n143\t      @collection_name = parse_expression(collection_name, safe: true)\n144\t\n145\t      @name     = \"#{@variable_name}-#{collection_name}\"\n146\t      @reversed = p.id?('reversed')\n147\t\n148\t      while p.look(:comma) || p.look(:id)\n149\t        p.consume?(:comma)\n150\t        unless (attribute = p.id?('limit') || p.id?('offset'))\n151\t          raise SyntaxError, options[:locale].t(\"errors.syntax.for_invalid_attribute\")\n152\t        end\n153\t        p.consume(:colon)\n154\t        set_attribute(attribute, p.expression, safe: true)\n155\t      end\n156\t      p.consume(:end_of_string)\n157\t    end\n158\t\n159\t    private\n160\t\n161\t    def strict2_parse(markup)\n162\t      strict_parse(markup)\n163\t    end\n164\t\n165\t    def collection_segment(context)\n166\t      offsets = context.registers[:for] ||= {}\n167\t\n168\t      from = if @from == :continue\n169\t        offsets[@name].to_i\n170\t      else\n171\t        from_value = context.evaluate(@from)\n172\t        if from_value.nil?\n173\t          0\n174\t        else\n175\t          Utils.to_integer(from_value)\n176\t        end\n177\t      end\n178\t\n179\t      collection = context.evaluate(@collection_name)\n180\t      collection = collection.to_a if collection.is_a?(Range)\n181\t\n182\t      limit_value = context.evaluate(@limit)\n183\t      to = if limit_value.nil?\n184\t        nil\n185\t      else\n186\t        Utils.to_integer(limit_value) + from\n187\t      end\n188\t\n189\t      segment = Utils.slice_collection(collection, from, to)\n190\t      segment.reverse! if @reversed\n191\t\n192\t      offsets[@name] = from + segment.length\n193\t\n194\t      segment\n195\t    end\n196\t\n197\t    def render_segment(context, output, segment)\n198\t      for_stack = context.registers[:for_stack] ||= []\n199\t      length    = segment.length\n200\t\n201\t      loop_vars = Liquid::ForloopDrop.new(@name, length, for_stack[-1])\n202\t      scope = { 'forloop' => loop_vars, @variable_name => nil }\n203\t\n204\t      context.stack(scope) do\n205\t        for_stack.push(loop_vars)\n206\t\n207\t        begin\n208\t          var_name = @variable_name\n209\t          for_block = @for_block\n210\t          segment.each do |item|\n211\t            context[var_name] = item\n212\t            for_block.render_to_output_buffer(context, output)\n213\t            loop_vars.increment!\n214\t\n215\t            # Handle any interrupts if they exist.\n216\t            next unless context.interrupt?\n217\t            interrupt = context.pop_interrupt\n218\t            break if interrupt.is_a?(BreakInterrupt)\n219\t            next if interrupt.is_a?(ContinueInterrupt)\n220\t          end\n221\t        ensure\n222\t          for_stack.pop\n223\t        end\n224\t      end\n225\t\n226\t      output\n227\t    end\n228\t\n229\t    def set_attribute(key, expr, safe: false)\n230\t      case key\n231\t      when 'offset'\n232\t        @from = if expr == 'continue'\n233\t          :continue\n234\t        else\n235\t          parse_expression(expr, safe: safe)\n236\t        end\n237\t      when 'limit'\n238\t        @limit = parse_expression(expr, safe: safe)\n239\t      end\n240\t    end\n241\t\n242\t    def render_else(context, output)\n243\t      if @else_block\n244\t        @else_block.render_to_output_buffer(context, output)\n245\t      else\n246\t        output\n247\t      end\n248\t    end\n249\t\n250\t    class ParseTreeVisitor < Liquid::ParseTreeVisitor\n251\t      def children\n252\t        (super + [@node.limit, @node.from, @node.collection_name]).compact\n253\t      end\n254\t    end\n255\t  end\n256\tend\n257\t"}]},"parent_tool_use_id":"toolu_012nEtAwdVLfDGBHXdBhBZ8V","session_id":"e124f829-72f3-41c5-b2aa-159fc86e3514","uuid":"f873565f-caa5-4593-8df6-5d062a95512f","timestamp":"2026-04-03T16:53:45.357Z"}
