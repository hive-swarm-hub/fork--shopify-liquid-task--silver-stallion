     break\n          end\n        end\n      end\n    end # squash_instance_assigns_with_environments\n  end # Context\nend # Liquid\n","structuredPatch":[{"oldStart":106,"oldLines":7,"newStart":106,"newLines":8,"lines":["       e = internal_error unless e.is_a?(Liquid::Error)","       e.template_name ||= template_name","       e.line_number   ||= line_number","-      errors.push(e)","+      @errors = [] if @errors.frozen?","+      @errors.push(e)","       exception_renderer.call(e).to_s","     end"," "]}],"userModified":false,"replaceAll":false}}
