{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FU5KRPAKqUMbH3cWb1x1zb","type":"tool_result","content":"1\t# frozen_string_literal: true\n2\t\n3\tmodule Liquid\n4\t  # Context keeps the variable stack and resolves variables, as well as keywords\n5\t  #\n6\t  #   context['variable'] = 'testing'\n7\t  #   context['variable'] #=> 'testing'\n8\t  #   context['true']     #=> true\n9\t  #   context['10.2232']  #=> 10.2232\n10\t  #\n11\t  #   context.stack do\n12\t  #      context['bob'] = 'bobsen'\n13\t  #   end\n14\t  #\n15\t  #   context['bob']  #=> nil  class Context\n16\t  class Context\n17\t    attr_reader :scopes, :errors, :registers, :environments, :resource_limits, :static_registers, :static_environments\n18\t    attr_accessor :exception_renderer, :template_name, :partial, :global_filter, :strict_variables, :strict_filters, :environment\n19\t\n20\t    # rubocop:disable Metrics/ParameterLists\n21\t    def self.build(environment: Environment.default, environments: {}, outer_scope: {}, registers: {}, rethrow_errors: false, resource_limits: nil, static_environments: {}, &block)\n22\t      new(environments, outer_scope, registers, rethrow_errors, resource_limits, static_environments, environment, &block)\n23\t    end\n24\t\n25\t    def initialize(environments = {}, outer_scope = {}, registers = {}, rethrow_errors = false, resource_limits = nil, static_environments = {}, environment = Environment.default)\n26\t      @environment = environment\n27\t      @environments = environments.is_a?(Array) ? environments : [environments]\n28\t\n29\t      @static_environments = if static_environments.is_a?(Array)\n30\t        static_environments.frozen? ? static_environments : static_environments.freeze\n31\t      elsif static_environments.empty?\n32\t        Const::EMPTY_ARRAY\n33\t      else\n34\t        [static_environments].freeze\n35\t      end\n36\t      @scopes              = [outer_scope || {}]\n37\t      @registers           = registers.is_a?(Registers) ? registers : Registers.new(registers)\n38\t      @errors              = []\n39\t      @partial             = false\n40\t      @strict_variables    = false\n41\t      @resource_limits     = resource_limits || ResourceLimits.new(environment.default_resource_limits)\n42\t      @base_scope_depth    = 0\n43\t      @interrupts          = Const::EMPTY_ARRAY\n44\t      @filters             = Const::EMPTY_ARRAY\n45\t      @global_filter       = nil\n46\t      @disabled_tags       = Const::EMPTY_HASH\n47\t\n48\t      # Lazy-init StringScanner — only needed if Context#[] is called during render\n49\t      @string_scanner = nil\n50\t\n51\t      @registers.static[:cached_partials] ||= {}\n52\t      @registers.static[:file_system] ||= environment.file_system\n53\t      @registers.static[:template_factory] ||= Liquid::TemplateFactory.new\n54\t\n55\t      self.exception_renderer = environment.exception_renderer\n56\t      if rethrow_errors\n57\t        self.exception_renderer = Liquid::RAISE_EXCEPTION_LAMBDA\n58\t      end\n59\t\n60\t      yield self if block_given?\n61\t\n62\t      # Do this last, since it could result in this object being passed to a Proc in the environment\n63\t      squash_instance_assigns_with_environments\n64\t    end\n65\t    # rubocop:enable Metrics/ParameterLists\n66\t\n67\t    def warnings\n68\t      @warnings ||= []\n69\t    end\n70\t\n71\t    def strainer\n72\t      @strainer ||= @environment.create_strainer(self, @filters)\n73\t    end\n74\t\n75\t    # Adds filters to this context.\n76\t    #\n77\t    # Note that this does not register the filters with the main Template object. see <tt>Template.register_filter</tt>\n78\t    # for that\n79\t    def add_filters(filters)\n80\t      filters = [filters].flatten.compact\n81\t      @filters += filters\n82\t      @strainer = nil\n83\t    end\n84\t\n85\t    def apply_global_filter(obj)\n86\t      global_filter.nil? ? obj : global_filter.call(obj)\n87\t    end\n88\t\n89\t    # are there any not handled interrupts?\n90\t    def interrupt?\n91\t      !@interrupts.frozen? && !@interrupts.empty?\n92\t    end\n93\t\n94\t    # push an interrupt to the stack. this interrupt is considered not handled.\n95\t    def push_interrupt(e)\n96\t      @interrupts = [] if @interrupts.frozen?\n97\t      @interrupts.push(e)\n98\t    end\n99\t\n100\t    # pop an interrupt from the stack\n101\t    def pop_interrupt\n102\t      @interrupts.pop\n103\t    end\n104\t\n105\t    def handle_error(e, line_number = nil)\n106\t      e = internal_error unless e.is_a?(Liquid::Error)\n107\t      e.template_name ||= template_name\n108\t      e.line_number   ||= line_number\n109\t      errors.push(e)\n110\t      exception_renderer.call(e).to_s\n111\t    end\n112\t\n113\t    def invoke(method, *args)\n114\t      strainer.invoke(method, *args).to_liquid\n115\t    end\n116\t\n117\t    # Fast path for single-argument filter invocation (the most common case:\n118\t    # {{ value | filter }}) — avoids *args splat allocation.\n119\t    def invoke_single(method, input)\n120\t      strainer.invoke_single(method, input).to_liquid\n121\t    end\n122\t\n123\t    # Fast path for two-argument filter invocation (e.g. {{ value | default: 'x' }})\n124\t    def invoke_two(method, input, arg1)\n125\t      strainer.invoke_two(method, input, arg1).to_liquid\n126\t    end\n127\t\n128\t    # Push new local scope on the stack. use <tt>Context#stack</tt> instead\n129\t    def push(new_scope = {})\n130\t      @scopes.unshift(new_scope)\n131\t      check_overflow\n132\t    end\n133\t\n134\t    # Merge a hash of variables in the current local scope\n135\t    def merge(new_scopes)\n136\t      @scopes[0].merge!(new_scopes)\n137\t    end\n138\t\n139\t    # Pop from the stack. use <tt>Context#stack</tt> instead\n140\t    def pop\n141\t      raise ContextError if @scopes.size == 1\n142\t      @scopes.shift\n143\t    end\n144\t\n145\t    # Pushes a new local scope on the stack, pops it at the end of the block\n146\t    #\n147\t    # Example:\n148\t    #   context.stack do\n149\t    #      context['var'] = 'hi'\n150\t    #   end\n151\t    #\n152\t    #   context['var']  #=> nil\n153\t    def stack(new_scope = {})\n154\t      push(new_scope)\n155\t      yield\n156\t    ensure\n157\t      pop\n158\t    end\n159\t\n160\t    # Creates a new context inheriting resource limits, filters, environment etc.,\n161\t    # but with an isolated scope.\n162\t    def new_isolated_subcontext\n163\t      check_overflow\n164\t\n165\t      self.class.build(\n166\t        environment: @environment,\n167\t        resource_limits: resource_limits,\n168\t        static_environments: static_environments,\n169\t        registers: Registers.new(registers),\n170\t      ).tap do |subcontext|\n171\t        subcontext.base_scope_depth   = base_scope_depth + 1\n172\t        subcontext.exception_renderer = exception_renderer\n173\t        subcontext.filters  = @filters\n174\t        subcontext.strainer = nil\n175\t        subcontext.errors   = errors\n176\t        subcontext.warnings = warnings\n177\t        subcontext.disabled_tags = @disabled_tags\n178\t      end\n179\t    end\n180\t\n181\t    def clear_instance_assigns\n182\t      @scopes[0] = {}\n183\t    end\n184\t\n185\t    # Only allow String, Numeric, Hash, Array, Proc, Boolean or <tt>Liquid::Drop</tt>\n186\t    def []=(key, value)\n187\t      @scopes[0][key] = value\n188\t    end\n189\t\n190\t    # Look up variable, either resolve directly after considering the name. We can directly handle\n191\t    # Strings, digits, floats and booleans (true,false).\n192\t    # If no match is made we lookup the variable in the current scope and\n193\t    # later move up to the parent blocks to see if we can resolve the variable somewhere up the tree.\n194\t    # Some special keywords return symbols. Those symbols are to be called on the rhs object in expressions\n195\t    #\n196\t    # Example:\n197\t    #   products == empty #=> products.empty?\n198\t    def [](expression)\n199\t      evaluate(Expression.parse(expression, @string_scanner ||= StringScanner.new(\"\")))\n200\t    end\n201\t\n202\t    def key?(key)\n203\t      find_variable(key, raise_on_not_found: false) != nil\n204\t    end\n205\t\n206\t    def evaluate(object)\n207\t      object.respond_to?(:evaluate) ? object.evaluate(self) : object\n208\t    end\n209\t\n210\t    # Fetches an object starting at the local scope and then moving up the hierachy\n211\t    def find_variable(key, raise_on_not_found: true)\n212\t      # Fast path: check top scope first (most common in for loops)\n213\t      scope = @scopes[0]\n214\t      if scope.key?(key)\n215\t        variable = lookup_and_evaluate(scope, key, raise_on_not_found: raise_on_not_found)\n216\t      elsif @scopes.length == 1\n217\t        # Only one scope and key not found — go straight to environments\n218\t        variable = try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n219\t      else\n220\t        # Multiple scopes — search through all of them\n221\t        index = @scopes.find_index { |s| s.key?(key) }\n222\t\n223\t        variable = if index\n224\t          lookup_and_evaluate(@scopes[index], key, raise_on_not_found: raise_on_not_found)\n225\t        else\n226\t          try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n227\t        end\n228\t      end\n229\t\n230\t      # update variable's context before invoking #to_liquid\n231\t      # Fast path: primitive types don't need context= or to_liquid conversion\n232\t      case variable\n233\t      when String, Integer, Float, NilClass, TrueClass, FalseClass\n234\t        return variable\n235\t      when Array, Hash, Time\n236\t        return variable\n237\t      end\n238\t\n239\t      variable.context = self if variable.respond_to?(:context=)\n240\t\n241\t      liquid_variable = variable.to_liquid\n242\t\n243\t      if variable != liquid_variable\n244\t        liquid_variable.context = self if liquid_variable.respond_to?(:context=)\n245\t      end\n246\t\n247\t      liquid_variable\n248\t    end\n249\t\n250\t    def lookup_and_evaluate(obj, key, raise_on_not_found: true)\n251\t      if @strict_variables && raise_on_not_found && obj.respond_to?(:key?) && !obj.key?(key)\n252\t        raise Liquid::UndefinedVariable, \"undefined variable #{key}\"\n253\t      end\n254\t\n255\t      value = obj[key]\n256\t\n257\t      if value.is_a?(Proc) && obj.respond_to?(:[]=)\n258\t        obj[key] = value.arity == 0 ? value.call : value.call(self)\n259\t      else\n260\t        value\n261\t      end\n262\t    end\n263\t\n264\t    def with_disabled_tags(tag_names)\n265\t      @disabled_tags = {} if @disabled_tags.frozen?\n266\t      tag_names.each do |name|\n267\t        @disabled_tags[name] = @disabled_tags.fetch(name, 0) + 1\n268\t      end\n269\t      yield\n270\t    ensure\n271\t      tag_names.each do |name|\n272\t        @disabled_tags[name] -= 1\n273\t      end\n274\t    end\n275\t\n276\t    def tag_disabled?(tag_name)\n277\t      @disabled_tags.fetch(tag_name, 0) > 0\n278\t    end\n279\t\n280\t    protected\n281\t\n282\t    attr_writer :base_scope_depth, :warnings, :errors, :strainer, :filters, :disabled_tags\n283\t\n284\t    private\n285\t\n286\t    attr_reader :base_scope_depth\n287\t\n288\t    def try_variable_find_in_environments(key, raise_on_not_found:)\n289\t      @environments.each do |environment|\n290\t        found_variable = lookup_and_evaluate(environment, key, raise_on_not_found: raise_on_not_found)\n291\t        if !found_variable.nil? || @strict_variables && raise_on_not_found\n292\t          return found_variable\n293\t        end\n294\t      end\n295\t      @static_environments.each do |environment|\n296\t        found_variable = lookup_and_evaluate(environment, key, raise_on_not_found: raise_on_not_found)\n297\t        if !found_variable.nil? || @strict_variables && raise_on_not_found\n298\t          return found_variable\n299\t        end\n300\t      end\n301\t      nil\n302\t    end\n303\t\n304\t    def check_overflow\n305\t      raise StackLevelError, \"Nesting too deep\" if overflow?\n306\t    end\n307\t\n308\t    def overflow?\n309\t      base_scope_depth + @scopes.length > Block::MAX_DEPTH\n310\t    end\n311\t\n312\t    def internal_error\n313\t      # raise and catch to set backtrace and cause on exception\n314\t      raise Liquid::InternalError, 'internal'\n315\t    rescue Liquid::InternalError => exc\n316\t      exc\n317\t    end\n318\t\n319\t    def squash_instance_assigns_with_environments\n320\t      @scopes.last.each_key do |k|\n321\t        @environments.each do |env|\n322\t          if env.key?(k)\n323\t            scopes.last[k] = lookup_and_evaluate(env, k)\n324\t            break\n325\t          end\n326\t        end\n327\t      end\n328\t    end # squash_instance_assigns_with_environments\n329\t  end # Context\n330\tend # Liquid\n331\t"}]},"parent_tool_use_id":null,"session_id":"77214d7b-bd04-44d4-b63f-1333e1a922ed","uuid":"be3158ab-1925-4fa5-b3b7-e2b13dcdcac6","timestamp":"2026-04-03T08:14:37.793Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/hive-swarm/shopify-liquid-task/silver-stallion/lib/liquid/context.rb","content":"# frozen_string_literal: true\n\nmodule Liquid\n  # Context keeps the variable stack and resolves variables, as well as keywords\n  #\n  #   context['variable'] = 'testing'\n  #   context['variable'] #=> 'testing'\n  #   context['true']     #=> true\n  #   context['10.2232']  #=> 10.2232\n  #\n  #   context.stack do\n  #      context['bob'] = 'bobsen'\n  #   end\n  #\n  #   context['bob']  #=> nil  class Context\n  class Context\n    attr_reader :scopes, :errors, :registers, :environments, :resource_limits, :static_registers, :static_environments\n    attr_accessor :exception_renderer, :template_name, :partial, :global_filter, :strict_variables, :strict_filters, :environment\n\n    # rubocop:disable Metrics/ParameterLists\n    def self.build(environment: Environment.default, environments: {}, outer_scope: {}, registers: {}, rethrow_errors: false, resource_limits: nil, static_environments: {}, &block)\n      new(environments, outer_scope, registers, rethrow_errors, resource_limits, static_environments, environment, &block)\n    end\n\n    def initialize(environments = {}, outer_scope = {}, registers = {}, rethrow_errors = false, resource_limits = nil, static_environments = {}, environment = Environment.default)\n      @environment = environment\n      @environments = environments.is_a?(Array) ? environments : [environments]\n\n      @static_environments = if static_environments.is_a?(Array)\n        static_environments.frozen? ? static_environments : static_environments.freeze\n      elsif static_environments.empty?\n        Const::EMPTY_ARRAY\n      else\n        [static_environments].freeze\n      end\n      @scopes              = [outer_scope || {}]\n      @registers           = registers.is_a?(Registers) ? registers : Registers.new(registers)\n      @errors              = []\n      @partial             = false\n      @strict_variables    = false\n      @resource_limits     = resource_limits || ResourceLimits.new(environment.default_resource_limits)\n      @base_scope_depth    = 0\n      @interrupts          = Const::EMPTY_ARRAY\n      @filters             = Const::EMPTY_ARRAY\n      @global_filter       = nil\n      @disabled_tags       = Const::EMPTY_HASH\n\n      # Lazy-init StringScanner — only needed if Context#[] is called during render\n      @string_scanner = nil\n\n      @registers.static[:cached_partials] ||= {}\n      @registers.static[:file_system] ||= environment.file_system\n      @registers.static[:template_factory] ||= Liquid::TemplateFactory.new\n\n      self.exception_renderer = environment.exception_renderer\n      if rethrow_errors\n        self.exception_renderer = Liquid::RAISE_EXCEPTION_LAMBDA\n      end\n\n      yield self if block_given?\n\n      # Do this last, since it could result in this object being passed to a Proc in the environment\n      squash_instance_assigns_with_environments\n    end\n    # rubocop:enable Metrics/ParameterLists\n\n    def warnings\n      @warnings ||= []\n    end\n\n    def strainer\n      @strainer ||= @environment.create_strainer(self, @filters)\n    end\n\n    # Adds filters to this context.\n    #\n    # Note that this does not register the filters with the main Template object. see <tt>Template.register_filter</tt>\n    # for that\n    def add_filters(filters)\n      filters = [filters].flatten.compact\n      @filters += filters\n      @strainer = nil\n    end\n\n    def apply_global_filter(obj)\n      global_filter.nil? ? obj : global_filter.call(obj)\n    end\n\n    # are there any not handled interrupts?\n    def interrupt?\n      !@interrupts.frozen? && !@interrupts.empty?\n    end\n\n    # push an interrupt to the stack. this interrupt is considered not handled.\n    def push_interrupt(e)\n      @interrupts = [] if @interrupts.frozen?\n      @interrupts.push(e)\n    end\n\n    # pop an interrupt from the stack\n    def pop_interrupt\n      @interrupts.pop\n    end\n\n    def handle_error(e, line_number = nil)\n      e = internal_error unless e.is_a?(Liquid::Error)\n      e.template_name ||= template_name\n      e.line_number   ||= line_number\n      errors.push(e)\n      exception_renderer.call(e).to_s\n    end\n\n    def invoke(method, *args)\n      strainer.invoke(method, *args).to_liquid\n    end\n\n    # Fast path for single-argument filter invocation (the most common case:\n    # {{ value | filter }}) — avoids *args splat allocation.\n    def invoke_single(method, input)\n      strainer.invoke_single(method, input).to_liquid\n    end\n\n    # Fast path for two-argument filter invocation (e.g. {{ value | default: 'x' }})\n    def invoke_two(method, input, arg1)\n      strainer.invoke_two(method, input, arg1).to_liquid\n    end\n\n    # Push new local scope on the stack. use <tt>Context#stack</tt> instead\n    def push(new_scope = {})\n      @scopes.unshift(new_scope)\n      check_overflow\n    end\n\n    # Merge a hash of variables in the current local scope\n    def merge(new_scopes)\n      @scopes[0].merge!(new_scopes)\n    end\n\n    # Pop from the stack. use <tt>Context#stack</tt> instead\n    def pop\n      raise ContextError if @scopes.size == 1\n      @scopes.shift\n    end\n\n    # Pushes a new local scope on the stack, pops it at the end of the block\n    #\n    # Example:\n    #   context.stack do\n    #      context['var'] = 'hi'\n    #   end\n    #\n    #   context['var']  #=> nil\n    def stack(new_scope = {})\n      push(new_scope)\n      yield\n    ensure\n      pop\n    end\n\n    # Creates a new context inheriting resource limits, filters, environment etc.,\n    # but with an isolated scope.\n    def new_isolated_subcontext\n      check_overflow\n\n      self.class.build(\n        environment: @environment,\n        resource_limits: resource_limits,\n        static_environments: static_environments,\n        registers: Registers.new(registers),\n      ).tap do |subcontext|\n        subcontext.base_scope_depth   = base_scope_depth + 1\n        subcontext.exception_renderer = exception_renderer\n        subcontext.filters  = @filters\n        subcontext.strainer = nil\n        subcontext.errors   = errors\n        subcontext.warnings = warnings\n        subcontext.disabled_tags = @disabled_tags\n      end\n    end\n\n    def clear_instance_assigns\n      @scopes[0] = {}\n    end\n\n    # Only allow String, Numeric, Hash, Array, Proc, Boolean or <tt>Liquid::Drop</tt>\n    def []=(key, value)\n      @scopes[0][key] = value\n    end\n\n    # Look up variable, either resolve directly after considering the name. We can directly handle\n    # Strings, digits, floats and booleans (true,false).\n    # If no match is made we lookup the variable in the current scope and\n    # later move up to the parent blocks to see if we can resolve the variable somewhere up the tree.\n    # Some special keywords return symbols. Those symbols are to be called on the rhs object in expressions\n    #\n    # Example:\n    #   products == empty #=> products.empty?\n    def [](expression)\n      evaluate(Expression.parse(expression, @string_scanner ||= StringScanner.new(\"\")))\n    end\n\n    def key?(key)\n      find_variable(key, raise_on_not_found: false) != nil\n    end\n\n    def evaluate(object)\n      object.respond_to?(:evaluate) ? object.evaluate(self) : object\n    end\n\n    # Fetches an object starting at the local scope and then moving up the hierachy\n    def find_variable(key, raise_on_not_found: true)\n      # Fast path: check top scope first (most common in for loops)\n      scope = @scopes[0]\n      if scope.key?(key)\n        variable = lookup_and_evaluate(scope, key, raise_on_not_found: raise_on_not_found)\n      elsif @scopes.length == 1\n        # Only one scope and key not found — go straight to environments\n        variable = try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n      else\n        # Multiple scopes — search through all of them\n        index = @scopes.find_index { |s| s.key?(key) }\n\n        variable = if index\n          lookup_and_evaluate(@scopes[index], key, raise_on_not_found: raise_on_not_found)\n        else\n          try_variable_find_in_environments(key, raise_on_not_found: raise_on_not_found)\n        end\n      end\n\n      # update variable's context before invoking #to_liquid\n      # Fast path: primitive types don't need context= or to_liquid conversion\n      case variable\n      when String, Integer, Float, NilClass, TrueClass, FalseClass\n        return variable\n      when Array, Hash, Time\n        return variable\n      end\n\n      variable.context = self if variable.respond_to?(:context=)\n\n      liquid_variable = variable.to_liquid\n\n      if variable != liquid_variable\n        liquid_variable.context = self if liquid_variable.respond_to?(:context=)\n      end\n\n      liquid_variable\n    end\n\n    def lookup_and_evaluate(obj, key, raise_on_not_found: true)\n      if @strict_variables && raise_on_not_found && obj.respond_to?(:key?) && !obj.key?(key)\n        raise Liquid::UndefinedVariable, \"undefined variable #{key}\"\n      end\n\n      value = obj[key]\n\n      if value.is_a?(Proc) && obj.respond_to?(:[]=)\n        obj[key] = value.arity == 0 ? value.call : value.call(self)\n      else\n        value\n      end\n    end\n\n    def with_disabled_tags(tag_names)\n      @disabled_tags = {} if @disabled_tags.frozen?\n      tag_names.each do |name|\n        @disabled_tags[name] = @disabled_tags.fetch(name, 0) + 1\n      end\n      yield\n    ensure\n      tag_names.each do |name|\n        @disabled_tags[name] -= 1\n      end\n    end\n\n    def tag_disabled?(tag_name)\n      @disabled_tags.fetch(tag_name, 0) > 0\n    end\n\n    protected\n\n    attr_writer :base_scope_depth, :warnings, :errors, :strainer, :filters, :disabled_tags\n\n    private\n\n    attr_reader :base_scope_depth\n\n    def try_variable_find_in_environments(key, raise_on_not_found:)\n      @environments.each do |environment|\n        found_variable = lookup_and_evaluate(environment, key, raise_on_not_found: raise_on_not_found)\n        if !found_variable.nil? || @strict_variables && raise_on_not_found\n          return found_variable\n        end\n      end\n      @static_environments.each do |environment|\n        found_variable = lookup_and_evaluate(environment, key, raise_on_not_found: raise_on_not_found)\n        if !found_variable.nil? || @strict_variables && raise_on_not_found\n          return found_variable\n        end\n      end\n      nil\n    end\n\n    def check_overflow\n      raise StackLevelError, \"Nesting too deep\" if overflow?\n    end\n\n    def overflow?\n      base_scope_depth + @scopes.length > Block::MAX_DEPTH\n    end\n\n    def internal_error\n      # raise and catch to set backtrace and cause on exception\n      raise Liquid::InternalError, 'internal'\n    rescue Liquid::InternalError => exc\n      exc\n    end\n\n    def squash_instance_assigns_with_environments\n      @scopes.last.each_key do |k|\n        @environments.each do |env|\n          if env.key?(k)\n            scopes.last[k] = lookup_and_evaluate(env, k)\n            break\n          end\n        end\n      end\n    end # squash_instance_assigns_with_environments\n  end # Context\nend # Liquid\n","numLines":331,"startLine":1,"totalLines":331}}}
